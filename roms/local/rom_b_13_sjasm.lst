# file opened: .//rom_b.asm
   1  0000              ; * Galaksija ROM B assembly listing
   2  0000              ;
   3  0000              ;  It macthes the binary file ROM_B.bin
   4  0000              ;  Original images from https://www.voja.rs/galaksija/ROM%20B%20Listing%20Scans/ROM_B_listing.htm
   5  0000              ;  Thanks Voja!
   6  0000              ;
   7  0000              ; * About this version;
   8  0000              ;  author: issalig 14/02/2025
   9  0000              ;  Converted to txt and translated with an LLM from the listing images
  10  0000              ;  The prompt used was:
  11  0000              ;     'I have a listing of z80 assembler. The typical line contains the address, the code of the instruction
  12  0000              ;   in hexadecimal, the number of line, a label, a mnemonic of the instruction, the parameters of the
  13  0000              ;   instruction and the comments. I want to convert it to text and translate into English the comments that
  14  0000              ;   are the end of the lines. Also put a ";" before the comment if it does not have it. please provide the
  15  0000              ;   full listing and do not miss any column'
  16  0000              ;
  17  0000              ;  Then some hours of sanding, polishing, hammering and comparing it with the original binary.
  18  0000              ;  LLMs are incredibly helpful but they are not still perfect.
  19  0000              ;
  20  0000              ;  Some labels are renamed not to be in confllict with instrucions or directives: ABS_, CPI_, SUB_
  21  0000              ;  <- has been converted to >> in order to work with pasmo and sjasmplus
  22  0000              ;  MONITOR_FIX has been included to provide different versions of the ROM
  23  0000              ; * Assembler
  24  0000              ;  To assemble it you can use
  25  0000              ;  - sjasmplus --raw=file.bin file.asm
  26  0000              ;  - pasmo -v  file.asm file.bin
  27  0000
  28  0000              ; 011078
  29  0000
  30  0000              ;********************************************************
  31  0000              ;*                                                      *
  32  0000              ;*         "GALAKSIJA" ROM B                            *
  33  0000              ;*                                                      *
  34  0000              ;*                             VOJA ANTONIC 12.07.84.   *
  35  0000              ;*                                                      *
  36  0000              ;********************************************************
  37  0000              SPACE    EQU     90
  38  0000              SHOMEM   EQU     2A97H
  39  0000              SHOFOR   EQU     2BB2H
  40  0000              OPTION   EQU     2BB3H
  41  0000              FIELD    EQU     2BB6H+34
  42  0000              INS1     EQU     FIELD+5
  43  0000              INS2     EQU     INS1+1
  44  0000              INS3     EQU     INS2+3
  45  0000              IXIY     EQU     INS3+3
  46  0000              CODE     EQU     IXIY+1
  47  0000              ADDR     EQU     CODE+5
  48  0000              TEXTBR   EQU     ADDR+2
  49  0000              TEMP1    EQU     TEXTBR+1
  50  0000              TEMP2    EQU     TEMP1+2
  51  0000              KRUG     EQU     2AAAH
  52  0000              FLAG2    EQU     2AABH
  53  0000              FREE     EQU     TEMP2+3
  54  0000              IXPOS2   EQU     FREE+2
  55  0000              DISPL    EQU     IXPOS2+2
  56  0000              FLAG     EQU     2BB5H
  57  0000              PLUS     EQU     0B32H
  58  0000              MINUS    EQU     0B1EH
  59  0000              PUTA     EQU     0AE6H
  60  0000              KROZ     EQU     0AF7H
  61  0000              CPIXIX   EQU     0B10H
  62  0000
  63  0000                      IFNDEF MONITOR_FIX
  64  0000 ~                    DEFINE MONITOR_FIX  0CH
  65  0000                      ENDIF
  66  0000                      ; ROM_B.bin                  0C (original)
  67  0000                      ; ROM_B_monitor_value_13.bin 0D
  68  0000                      ; ROM_B_monitor_fix.bin      0B
  69  0000
  70  0000                      ORG     1000H
  71  1000 2A 6A 2A             LD      HL,(2A6AH) ; IF (ENDMEM)=0 THEN (ENDMEM)=0FFFFH
  72  1003 7C                   LD      A,H
  73  1004 B5                   OR      L
  74  1005 20 04                JR      NZ,NOT56K ; ENDMEM > 0
  75  1007 2B                   DEC     HL ; CORRECTED ENDMEM
  76  1008 22 6A 2A             LD      (2A6AH),HL
  77  100B 3E 0C        NOT56K:  LD      A,0CH
  78  100D 18 13                JR      GOINI
  79  100F E3           ZALINK:  EX      (SP),HL
  80  1010 D5                   PUSH    DE
  81  1011 11 5B 07             LD      DE,75BH ; THIS IS THE POSITION WHERE IT WOULD JUMP IF NOT...
  82  1014 D7                   RST     10H ; ...RECOGNIZED WORD IN BASIC PROGRAM
  83  1015 20 1D                JR      NZ,DRUGIP
  84  1017 21 F0 1D             LD      HL,TEXT1-1 ; TABLE OF NEW WORDS
  85  101A D1                   POP     DE
  86  101B F1           CASE1:   POP     AF
  87  101C C3 9A 03             JP      39AH ; RECOGNIZE NEW WORD; IF IT DOESN'T EXIST IN TABLE...
  88  101F C3 5B 07     KAO75B:  JP      75BH ; ...JUMP TO 10FH, THEN TO 75BH (SEE Z100)
  89  1022 E7           GOINI:   RST     20H
  90  1023              ; byte #1024 changes in different versions of the ROM
  91  1023              ; ROM_B_monitor_value_13.bin byte is 13(D)
  92  1023              ; ROM_B.bin is 12(C)
  93  1023              ; ROM_B_monitor_fix.bin 11 (B)
  94  1023 3E 0D                LD      A, 13 ; NEW HORIZONTAL POSITION
  95  1025 32 A8 2B             LD      (2BA8H),A
  96  1028 21 A1 10             LD      HL,LINKS ; INSERT JP INSTEAD OF RET IN LINKS
  97  102B 11 A9 2B             LD      DE,2BA9H
  98  102E 01 06 00             LD      BC,6
  99  1031 ED B0                LDIR ; INITIALIZATION OF ROM-A 2
 100  1033 C9                   RET
 101  1034 11 8E 04     DRUGIP:  LD      DE,48EH ; SECOND ATTEMPT: CHECK IF IT'S CORRECTLY RECOGNIZED...
 102  1037 D7                   RST     10H ; WORD 'PRINT', IF IT IS, CHECK WHAT FOLLOWS
 103  1038 20 13                JR      NZ,TRECIP
 104  103A D1                   POP     DE
 105  103B E3                   EX      (SP),HL
 106  103C F1                   POP     AF
 107  103D DF                   RST     18H
 108  103E 25                   DEFB    '%'
 109  103F 0A                   DEFB    KAO48E-$-1
 110  1040 CF                   RST     8
 111  1041 3E 20                LD      A,' ' ; WRITE BLANK
 112  1043 E7                   RST     20H
 113  1044 CD 4C 13             CALL    HEX16B ; WRITE NUMBER IN HEX FORMAT
 114  1047 C3 AD 04             JP      4ADH
 115  104A C3 8E 04     KAO48E:  JP      48EH ; CONTINUES WHERE IT STARTED IF '%' DOESN'T FOLLOW
 116  104D 11 77 07     TRECIP:  LD      DE,777H ; THIRD ATTEMPT: CHECK IF IT TRIED TO RECOGNIZE...
 117  1050 D7                   RST     10H ; ...FUNCTION, BUT FAILED (777H IS ADDRESS...
 118  1051 D1                   POP     DE ; ...TO WHICH IT WOULD JUMP IN THAT CASE)
 119  1052 E3                   EX      (SP),HL
 120  1053 C0                   RET     NZ
 121  1054 21 23 1E             LD      HL,TEXT3-1 ; TABLE OF NEW FUNCTIONS
 122  1057 18 C2                JR      CASE1 ; END IS SAME AS IN FIRST ATTEMPT
 123  1059 C3 77 07     KAO777:  JP      777H
 124  105C 01 80 04     LPRINT:  LD      BC,480H ; 'LPRINT' ENTRY POINT: RET ADDRESS TO 'PRINT'
 125  105F C5                   PUSH    BC ; GOES TO STACK
 126  1060 3E FF        COPY:    LD      A,0FFH ; SETS LPRINT FLAG
 127  1062 32 B5 2B             LD      (FLAG),A
 128  1065 C9                   RET
 129  1066 CD 60 10     LLIST:   CALL    COPY ; 'LLIST' ENTRY POINT: SET FLAG
 130  1069 CD D3 0C             CALL    0CD3H ; CONTINUE AS LLIST
 131  106C C3 64 04             JP      464H
 132  106F F5           VIDEO:   PUSH    AF ; ADDITION TO SUBPROGRAM THAT WRITES CHARACTER TO...
 133  1070 2A B5 2B             LD      HL,(FLAG) ; ...VIDEO MEM (958H, BUT HERE IS CHECKING...
 134  1073 2C                   INC     L ; IS THE FLAG FOR PRINTER SET?
 135  1074 20 21                JR      NZ,NCOPY ; IF NOT, EXIT
 136  1076 21 AB 2A             LD      HL,2AABH ; CHECK IF FLAG IS SET TO NOT WRITE...
 137  1079 CB 46                BIT     0,(HL) ; ...CONTROL CHARS?
 138  107B 20 0E                JR      NZ,STAND ; IF YES, SKIP CHARACTER CHANGE
 139  107D 21 99 10             LD      HL,TABCZS ; IF NOT, POINTER TO TABLE
 140  1080 06 04                LD      B,4 ; TOTAL 4 CHARS FOR COMPARISON
 141  1082 BE           TEST4:   CP      (HL) ; IS THIS THE SEARCHED WORD?
 142  1083 23                   INC     HL
 143  1084 28 04                JR      Z,FOUND4 ; YES, JUMP
 144  1086 23                   INC     HL
 145  1087 10 F9                DJNZ    TEST4 ; TRY NEXT
 146  1089 26                   DEFB    26H ; AS 'LD H,ZEH' - TO SAVE MEMORY...
 147  108A 7E           FOUND4:  LD      A,(HL) ; ...SKIP NEXT WORD
 148  108B F5           STAND:   PUSH    AF ; ...SAVE NEW WORD
 149  108C CD FF 02     RDY:     CALL    2FFH ; 'BREAK' TEST
 150  108F DB FF                IN      A,(255)
 151  1091 17                   RLA
 152  1092 38 F8                JR      C,RDY ; JUMP IF PRINTER IS BUSY
 153  1094 F1                   POP     AF
 154  1095 D3 FF                OUT     (255),A ; PRINTER FREE - SEND CHARACTER
 155  1097 F1           NCOPY:   POP     AF
 156  1098 C9                   RET
 157  1099 5B           TABCZS:  DEFB    91 ; = C caron
 158  109A 43                   DEFB    'C'
 159  109B 5C                   DEFB    92
 160  109C 43                   DEFB    'C' ; = C acute
 161  109D 5D                   DEFB    93
 162  109E 5A                   DEFB    'Z' ; = Z caron
 163  109F 5E                   DEFB    94
 164  10A0 53                   DEFB    'S' ; = S caron
 165  10A1 C3           LINKS:   DEFB    0C3H
 166  10A2 0F 10                DEFW    ZALINK ; CHECK LINE 655 (C3H=JP)
 167  10A4 C3                   DEFB    0C3H
 168  10A5 6F 10                DEFW    VIDEO
 169  10A7 2A 9F 2A     GOASS:   LD      HL,(2A9FH) ; ********** ASSEMBLER **********
 170  10AA 7C                   LD      A,H ; IS IT COMMAND MODE?
 171  10AB B5                   OR      L
 172  10AC CA 5A 06             JP      Z,1626D ; IF YES
 173  10AF EB                   EX      DE,HL ; MAIN POINTER WILL BE HL
 174  10B0 3E 01                LD      A,1 ; SET OPT 1
 175  10B2 32 B3 2B             LD      (OPTION),A
 176  10B5 CD BF 10             CALL    START1 ; CALL PROGRAM FOR ASSEMBLY
 177  10B8 DD 21 AC 2A          LD      IX,2AACH ; RETURN CORRECT VALUE IX REGISTER
 178  10BC 2B                   DEC     HL
 179  10BD EB                   EX      DE,HL ; RETURN POINTER DE
 180  10BE F7                   RST     30H ; GO BACK TO BASIC
 181  10BF AF           START1:  XOR     A
 182  10C0 32 AA 2A             LD      (KRUG),A ; FIRST ASSEMBLY PASS
 183  10C3 32 DD 2B             LD      (INS1),A ; EXECUTE OPCODE TOKEN
 184  10C6 EB                   EX      DE,HL ; SAVE HL IN DE
 185  10C7 EF                   RST     28H ; THIS IS LD HL,0
 186  10C8 22 F6 2B             LD      (DISPL),HL
 187  10CB 22 97 2A             LD      (SHOMEM),HL ; FOR 'REG'; SHOWS 0 BYTES OF MEMORY
 188  10CE 2A 6A 2A             LD      HL,(2A6AH) ; = ENDMEM
 189  10D1 2B                   DEC     HL
 190  10D2 77                   LD      (HL),A ; 0 = TERMINATOR TABLE FOR LABELS
 191  10D3 2B                   DEC     HL
 192  10D4 77                   LD      (HL),A
 193  10D5 EB                   EX      DE,HL ; RETURN HL
 194  10D6 CD 52 17             CALL    FINDCR ; FIND END OF LINE WHERE IS '<'
 195  10D9 E5                   PUSH    HL ; SAVE POINTER FOR SECOND PASS
 196  10DA CD E6 10             CALL    ASS ; FIRST ASSEMBLY PASS
 197  10DD 21 AA 2A             LD      HL,KRUG
 198  10E0 34                   INC     (HL) ; SET SECOND PASS
 199  10E1 AF                   XOR     A
 200  10E2 32 DD 2B             LD      (INS1),A ; EXECUTE OPCODES
 201  10E5 E1                   POP     HL ; RETURN POINTER TO START 1...
 202  10E6 AF           ASS:     XOR     A ; ...ENTER IN SECOND PASS
 203  10E7 32 EC 2B             LD      (TEXTBR),A ; 0 WORDS IN TEXT
 204  10EA 32 EA 2B             LD      (ADDR),A ; ERASE LABEL ADDRESS IN PROGRAM
 205  10ED 32 EB 2B             LD      (ADDR+1),A
 206  10F0              LOOP     EQU     $ ; FOLLOWING 13 LINES ARE MAIN LOOP
 207  10F0 22 9F 2A             LD      (2A9FH),HL ; POSITION OF CURRENT LINE(FOR ERROR CASE)
 208  10F3 ED 5B 38 2C          LD      DE,(2C38H) ; END OF BASIC
 209  10F7 D7                   RST     10H
 210  10F8 D0                   RET     NC ; RETURN IF IT'S END AND NO '>'
 211  10F9 3A DD 2B             LD      A,(INS1)
 212  10FC FE 08                CP      8
 213  10FE C8                   RET     Z ; RETURN IF IT'S '>'
 214  10FF CD FF 02             CALL    2FFH ; 'BREAK' TEST
 215  1102 CD 33 17             CALL    PROG1 ; FIRST PART: PUTTING TOKEN IN TABLE
 216  1105 E5                   PUSH    HL
 217  1106 CD 0C 11             CALL    PROG2 ; SECOND PART: CODE FORMING
 218  1109 E1                   POP     HL
 219  110A 18 E4                JR      LOOP ; BACK TO MAIN LOOP
 220  110C 21 4D 12     PROG2:   LD      HL,GOON ; THIS IS RET ADDRESS FOR END OF SUBROUTINE
 221  110F E5                   PUSH    HL
 222  1110 21 DE 2B             LD      HL,INS2
 223  1113 DD 21 DB 2B          LD      IX,FIELD+3
 224  1117 3A DD 2B             LD      A,(INS1)
 225  111A B7                   OR      A
 226  111B C8                   RET     Z ; NOTHING IN THIS LINE - GO TO GOON
 227  111C FE 09                CP      9 ; IS IT SPECIAL WORD (TOKEN=9)
 228  111E D2 24 13             JP      NC,NCOMM ; NO - NEXT WORD FOR ASSEMBLY
 229  1121 3D                   DEC     A
 230  1122 20 27                JR      NZ,NSTAT ; NOT TOKEN 1
 231  1124 21 78 19             LD      HL,BRKPT ; TOKEN 1: 'REG' (BREAKPOINT)
 232  1127 22 E6 2B             LD      (CODE+1),HL ; BREAKPOINT ADDRESS
 233  112A 3E CD                LD      A,0CDH ; CODE FOR 'CALL'
 234  112C 32 E5 2B             LD      (CODE),A
 235  112F 3E 03                LD      A,3
 236  1131 32 E9 2B             LD      (CODE+4),A ; 3 BYTES CODED LENGTH
 237  1134 2A DF 2B             LD      HL,(INS2+1) ; IS THERE MEMORY DISPLAY?
 238  1137 7C                   LD      A,H
 239  1138 B5                   OR      L
 240  1139 C8                   RET     Z ; NO - GO TO GOON
 241  113A CD 1B 13             CALL    IFNUM2 ; IS IT NUMERIC VALUE (IF NOT-WHAT?)
 242  113D 22 97 2A             LD      (SHOMEM),HL ; SHOW HL MEMORY
 243  1140 3A E2 2B             LD      A,(INS3+1) ; HOW MANY ROWS?
 244  1143 B7                   OR      A
 245  1144 20 01                JR      NZ,IMA ; NUMBER OF ROWS SPECIFIED
 246  1146 3C                   INC     A ; NOT SPECIFIED - THEN 1 ROW
 247  1147 32 B2 2B     IMA:     LD      (SHOFOR),A ; = SHOW FORMAT
 248  114A C9                   RET
 249  114B 3D           NSTAT:   DEC     A
 250  114C 20 21                JR      NZ,NTEXT ; NOT TOKEN 2
 251  114E 7E                   LD      A,(HL) ; TOKEN 2: 'TEXT'
 252  114F 32 EC 2B             LD      (TEXTBR),A ; NUMBER OF TEXT WORDS
 253  1152 11 E5 2B             LD      DE,CODE
 254  1155 06 03        TEXTIT:  LD      B,3 ; 3 BYTES IN ONE ROW
 255  1157 3A EC 2B     TXT4:    LD      A,(TEXTBR) ; HOW MANY WORDS LEFT?
 256  115A B7                   OR      A
 257  115B C8                   RET     Z ; NONE - GO TO GOON
 258  115C DD 35 11             DEC     (IX+17) ; DECREASE WORD COUNT
 259  115F 2A DF 2B             LD      HL,(INS2+1) ; TEXT ADDRESS IN PROGRAM
 260  1162 7E                   LD      A,(HL) ; TAKE WORD OR CHARACTER
 261  1163 23                   INC     HL ; INCREASE POINTER
 262  1164 22 DF 2B             LD      (INS2+1),HL ; AND RETURN IT
 263  1167 12                   LD      (DE),A ; PUT CHARACTER IN CODE
 264  1168 13                   INC     DE ; INCREASE CODE POINTER
 265  1169 DD 34 0E             INC     (IX+14) ; INCREASE BYTE COUNT
 266  116C 10 E9                DJNZ    TXT4 ; DO THIS 3 TIMES IN EACH ROW
 267  116E C9                   RET ; GO TO GOON
 268  116F 3D           NTEXT:   DEC     A
 269  1170 20 04                JR      NZ,NWORD ; NOT TOKEN 3
 270  1172 3C                   INC     A ; TOKEN 3: 'WORD'
 271  1173 DD 77 0E             LD      (IX+14),A ; BYTE COUNT=1 (AND ON 5120 WILL BE +1)
 272  1176 3D           NWORD:   DEC     A
 273  1177 20 0C                JR      NZ,NBYTE ; NOT TOKEN 4 OR 3
 274  1179 CD 18 13             CALL    IFNUM1 ; TOKEN 4: 'BYTE'
 275  117C 2A DF 2B             LD      HL,(INS2+1) ; TAKE CODE
 276  117F 22 E5 2B             LD      (CODE),HL ; PUT IT IN ITS PLACE
 277  1182 C3 48 13             JP      IXGOON ; SEE 5120
 278  1185 3D           NBYTE:   DEC     A
 279  1186 20 23                JR      NZ,NOPT ; NOT TOKEN 5
 280  1188 CD 1B 13             CALL    IFNUM2 ; TOKEN 5: 'OPT' (IF >255, WHAT)
 281  118B 2A DF 2B             LD      HL,(INS2+1) ; TAKE NUMBER OPTION
 282  118E 7D                   LD      A,L ; U A REG
 283  118F E6 04                AND     4 ; IF BIT 2 IS SET (4-5-6-7)
 284  1191              ;new page
 285  1191 C4 60 10             CALL NZ,COPY ; SET FLAG FOR PRINTER
 286  1194 7D                   LD A,L
 287  1195 E6 03                AND 3
 288  1197 32 B3 2B             LD (OPTION),A ; MASK TO BE LESS THAN 4
 289  119A 3A E1 2B             LD A,(INS3)
 290  119D B7                   OR A ; IS RELOCATION REQUESTED ON WRITE?
 291  119E C8                   RET Z ; NO - GO TO GOON
 292  119F FE 40                CP 40H
 293  11A1 C2 2D 19             JP NZ,WHATHL ; NOT NUMERIC - ERROR
 294  11A4 2A E2 2B             LD HL,(INS3+1) ; RELOCATION SIZE...
 295  11A7 22 F6 2B             LD (DISPL),HL ; ...TO ITS PLACE
 296  11AA C9                   RET
 297  11AB 3D           NOPT:    DEC A
 298  11AC 20 0D                JR NZ,NORG ; NOT TOKEN 6
 299  11AE CD 18 13             CALL IFNUM1 ; TOKEN 6: 'ORG'
 300  11B1 2A DF 2B             LD HL,(INS2+1)
 301  11B4 22 ED 2B             LD (TEMP1),HL ; TEMPORARY ADDRESS
 302  11B7 22 EA 2B     SKR4:    LD (ADDR),HL ; MAIN POINTER OF PC ADDRESS
 303  11BA C9                   RET
 304  11BB 3D           NORG:    DEC A
 305  11BC C0                   RET NZ ; END = TOKEN 8 '>'
 306  11BD CD 18 13             CALL IFNUM1 ; TOKEN 7: 'EQU'
 307  11C0 ED 4B DF 2B          LD BC,(INS2+1)
 308  11C4 ED 43 ED 2B          LD (TEMP1),BC ; LABEL ADDRESS
 309  11C8 CD D2 11             CALL CREATE ; FORM LABEL
 310  11CB CA 2D 19             JP Z,WHATHL ; IF NOT PROVIDED - WHAT
 311  11CE F1                   POP AF ; RESTORE STACK - WON'T GO TO GOON
 312  11CF C3 54 12             JP GOON1 ; BUT TO GOON1
 313  11D2 3A AA 2A     CREATE:  LD A,(KRUG) ; ---- LABEL FORMATION ----
 314  11D5 B7                   OR A
 315  11D6 C0                   RET NZ ; CANNOT BE FORMED IN SECOND PASS
 316  11D7 2A DA 2B             LD HL,(FIELD+2)
 317  11DA 7C                   LD A,H
 318  11DB B5                   OR L
 319  11DC C8                   RET Z ; RETURN IF LABEL ADDRESS DOESN'T EXIST
 320  11DD CD 15 12             CALL LOCAT2 ; CHECK IF IT'S ALREADY FORMED
 321  11E0 CA 4F 16             JP Z,HOWHL ; IF IT EXISTS - CANNOT BE FORMED TWICE (HOW?)
 322  11E3 E5           TRANSF:  PUSH HL
 323  11E4 2A 38 2C             LD HL,(2C38H) ; END OF BASIC PROGRAM
 324  11E7 D7                   RST 10H
 325  11E8 E1                   POP HL
 326  11E9 D2 53 01             JP NC,339D ; SORRY - NO MEMORY
 327  11EC 7E                   LD A,(HL)
 328  11ED 12                   LD (DE),A ; TRANSFER LETTER BY LETTER TO TABLE
 329  11EE 23                   INC HL
 330  11EF 1B                   DEC DE
 331  11F0 CD 50 18             CALL NCSLBR ; IF LETTER OR NUMBER
 332  11F3 30 EE                JR NC,TRANSF ; ...CONTINUE WITH TRANSFER
 333  11F5 EB           NOTRAN:  EX DE,HL
 334  11F6 23                   INC HL
 335  11F7 CB FE                SET 7,(HL) ; WORD TERMINATOR = BIT 7 SET
 336  11F9 2B                   DEC HL
 337  11FA 70                   LD (HL),B ; BC = LABEL VALUE
 338  11FB 2B                   DEC HL
 339  11FC 71                   LD (HL),C
 340  11FD 2B                   DEC HL
 341  11FE 36 00                LD (HL),0 ; TABLE TERMINATOR
 342  1200 EB                   EX DE,HL ; HL = POINTER NOW BEHIND NAME
 343  1201 AF                   XOR A ; RESET Z FLAG (SIGN THAT EVERYTHING IS OK)
 344  1202 3C                   INC A ; NEW POSITION IN TABLE
 345  1203 C9                   RET
 346  1204              ;new page
 347  1204 3A AA 2A     LOCATE:  LD    A,(KRUG) ; ---- LOOP LABEL ----
 348  1207 B7                   OR    A
 349  1208 20 0B                JR    NZ,LOCAT2 ; ONLY IN SECOND LOOP
 350  120A 2B                   DEC   HL ; AND IN 1. LOOP JUST SKIP NAME
 351  120B 23           SRC20H:  INC   HL
 352  120C CD 50 18             CALL  NCSLBR
 353  120F 30 FA                JR    NC,SRC20H
 354  1211 AF                   XOR   A
 355  1212 47                   LD    B,A
 356  1213 4F                   LD    C,A
 357  1214 C9                   RET
 358  1215 E5           LOCAT2:  PUSH  HL
 359  1216 D9                   EXX
 360  1217 2A 6A 2A             LD    HL,(2A6AH) ; END OF MEMORY (START OF COMPARISON)
 361  121A 2B                   DEC   HL
 362  121B 18 12                JR    IFF1R ; START
 363  121D D1           GOSRCH:  POP   DE ; RECONSTRUCT POINTER
 364  121E D5                   PUSH  DE
 365  121F 1A           GOSRC2:  LD    A,(DE) ; TAKE FROM PROGRAM TEXT
 366  1220 BE                   CP    (HL) ; AND COMPARE WITH LABEL LIST
 367  1221 28 16                JR    Z,FOUNDV ; ONE WORD MATCHES
 368  1223 F6 80                OR    80H ; SET BIT 7 (AS IN THE LAST CHARACTER)
 369  1225 BE                   CP    (HL) ; AND COMPARE AGAIN (MAYBE IT'S THE END)
 370  1226 28 15                JR    Z,BASFDU ; STILL - SUCCESSFUL COMPARISON
 371  1228 CB 7E        SRCHV:   BIT   7,(HL) ; NO - FIND END OF THIS NAME IN LIST
 372  122A 2B                   DEC   HL
 373  122B 28 FB                JR    Z,SRCHV ; NOT THE END YET
 374  122D 2B                   DEC   HL ; SKIP VALUE IN LIST
 375  122E 2B                   DEC   HL ; ONE MORE BYTE
 376  122F 7E           IFF1R:   LD    A,(HL) ; NEXT NAME (FIRST CHARACTER)
 377  1230 B7                   OR    A ; MAYBE IT'S NULL (TERMINATOR TABLE)?
 378  1231 20 EA                JR    NZ,GOSRCH ; NO - CONTINUE COMPARISON
 379  1233 E5                   PUSH  HL ; TRANSFER HL TO DE
 380  1234 D9                   EXX ; ...OF ALTERNATIVE SET
 381  1235 D1                   POP   DE ; DE = NEW POSITION IN TABLE
 382  1236 E1                   POP   HL ; RECONSTRUCT HL
 383  1237 3C                   INC   A ; A=1 (SIGN THAT NAME NOT FOUND)
 384  1238 C9                   RET
 385  1239 2B           FOUNDV:  DEC   HL ; COMPARISON GOING WELL
 386  123A 13                   INC   DE ; GO TO NEW CHARACTER
 387  123B 18 E2                JR    GOSRC2 ; CONTINUE COMPARISON
 388  123D 13           BASFDU:  INC   DE ; GO TO NEW CHARACTER IN PROGRAM
 389  123E EB                   EX    DE,HL
 390  123F CD 50 18             CALL  NCSLBR ; IF IT'S WORD OR NUMBER, RESET CARRY
 391  1242 EB                   EX    DE,HL
 392  1243 30 E3                JR    NC,SRCHV ; SO SAY LONG-NO SUCCESSFUL COMPARISON
 393  1245 2B                   DEC   HL ; FULLY SUCCESSFUL COMPARISON; GO TO VALUE
 394  1246 46                   LD    B,(HL) ; HIGH BYTE
 395  1247 2B                   DEC   HL
 396  1248 4E                   LD    C,(HL) ; BC = VALUE
 397  1249 EB                   EX    DE,HL ; HL = POINTER TO NAME
 398  124A D1                   POP   DE ; DE = START POINTER
 399  124B AF                   XOR   A ; A = 0 (SIGN THAT NAME IS FOUND IN LIST)
 400  124C C9                   RET

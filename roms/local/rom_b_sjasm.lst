# file opened: .//rom_b.asm
   1  0000              ; * Galaksija ROM B assembly listing
   2  0000              ;
   3  0000              ;  It macthes the binary file ROM_B.bin
   4  0000              ;  Original images from https://www.voja.rs/galaksija/ROM%20B%20Listing%20Scans/ROM_B_listing.htm
   5  0000              ;  Thanks Voja!
   6  0000              ;
   7  0000              ; * About this version;
   8  0000              ;  author: issalig 14/02/2025
   9  0000              ;  Converted to txt and translated with an LLM from the listing images
  10  0000              ;  The prompt used was:
  11  0000              ;     'I have a listing of z80 assembler. The typical line contains the address, the code of the instruction
  12  0000              ;   in hexadecimal, the number of line, a label, a mnemonic of the instruction, the parameters of the
  13  0000              ;   instruction and the comments. I want to convert it to text and translate into English the comments that
  14  0000              ;   are the end of the lines. Also put a ";" before the comment if it does not have it. please provide the
  15  0000              ;   full listing and do not miss any column'
  16  0000              ;
  17  0000              ;  Then some hours of sanding, polishing, hammering and comparing it with the original binary.
  18  0000              ;  LLMs are incredibly helpful but they are not still perfect.
  19  0000              ;
  20  0000              ;  Some labels are renamed not to be in confllict with instrucions or directives: ABS_, CPI_, SUB_
  21  0000              ;  <- has been converted to >> in order to work with pasmo and sjasmplus
  22  0000              ;  MONITOR has been included to provide different versions of the ROM
  23  0000              ; * Assembler
  24  0000              ;  To assemble it you can use
  25  0000              ;  - sjasmplus --raw=file.bin file.asm
  26  0000              ;  - pasmo -v  file.asm file.bin
  27  0000
  28  0000              ; 011078
  29  0000
  30  0000              ;********************************************************
  31  0000              ;*                                                      *
  32  0000              ;*         "GALAKSIJA" ROM B                            *
  33  0000              ;*                                                      *
  34  0000              ;*                             VOJA ANTONIC 12.07.84.   *
  35  0000              ;*                                                      *
  36  0000              ;********************************************************
  37  0000              SPACE    EQU     90
  38  0000              SHOMEM   EQU     2A97H
  39  0000              SHOFOR   EQU     2BB2H
  40  0000              OPTION   EQU     2BB3H
  41  0000              FIELD    EQU     2BB6H+34
  42  0000              INS1     EQU     FIELD+5
  43  0000              INS2     EQU     INS1+1
  44  0000              INS3     EQU     INS2+3
  45  0000              IXIY     EQU     INS3+3
  46  0000              CODE     EQU     IXIY+1
  47  0000              ADDR     EQU     CODE+5
  48  0000              TEXTBR   EQU     ADDR+2
  49  0000              TEMP1    EQU     TEXTBR+1
  50  0000              TEMP2    EQU     TEMP1+2
  51  0000              KRUG     EQU     2AAAH
  52  0000              FLAG2    EQU     2AABH
  53  0000              FREE     EQU     TEMP2+3
  54  0000              IXPOS2   EQU     FREE+2
  55  0000              DISPL    EQU     IXPOS2+2
  56  0000              FLAG     EQU     2BB5H
  57  0000              PLUS     EQU     0B32H
  58  0000              MINUS    EQU     0B1EH
  59  0000              PUTA     EQU     0AE6H
  60  0000              KROZ     EQU     0AF7H
  61  0000              CPIXIX   EQU     0B10H
  62  0000
  63  0000              MONITOR  EQU     0CH  ; ROM_B.bin is 0C
  64  0000                                    ; ROM_B_monitor_value_13.bin 0D
  65  0000                                    ; ROM_B_monitor_fix.bin 0B
  66  0000
  67  0000                      ORG     1000H
  68  1000 2A 6A 2A             LD      HL,(2A6AH) ; IF (ENDMEM)=0 THEN (ENDMEM)=0FFFFH
  69  1003 7C                   LD      A,H
  70  1004 B5                   OR      L
  71  1005 20 04                JR      NZ,NOT56K ; ENDMEM > 0
  72  1007 2B                   DEC     HL ; CORRECTED ENDMEM
  73  1008 22 6A 2A             LD      (2A6AH),HL
  74  100B 3E 0C        NOT56K:  LD      A,0CH
  75  100D 18 13                JR      GOINI
  76  100F E3           ZALINK:  EX      (SP),HL
  77  1010 D5                   PUSH    DE
  78  1011 11 5B 07             LD      DE,75BH ; THIS IS THE POSITION WHERE IT WOULD JUMP IF NOT...
  79  1014 D7                   RST     10H ; ...RECOGNIZED WORD IN BASIC PROGRAM
  80  1015 20 1D                JR      NZ,DRUGIP
  81  1017 21 F0 1D             LD      HL,TEXT1-1 ; TABLE OF NEW WORDS
  82  101A D1                   POP     DE
  83  101B F1           CASE1:   POP     AF
  84  101C C3 9A 03             JP      39AH ; RECOGNIZE NEW WORD; IF IT DOESN'T EXIST IN TABLE...
  85  101F C3 5B 07     KAO75B:  JP      75BH ; ...JUMP TO 10FH, THEN TO 75BH (SEE Z100)
  86  1022 E7           GOINI:   RST     20H
  87  1023              ; byte #1024 changes in different versions of the ROM
  88  1023              ; ROM_B_monitor_value_13.bin byte is 13(D)
  89  1023              ; ROM_B.bin is 12(C)
  90  1023              ; ROM_B_monitor_fix.bin 11 (B)
  91  1023 3E 0C                LD      A, MONITOR ; NEW HORIZONTAL POSITION
  92  1025 32 A8 2B             LD      (2BA8H),A
  93  1028 21 A1 10             LD      HL,LINKS ; INSERT JP INSTEAD OF RET IN LINKS
  94  102B 11 A9 2B             LD      DE,2BA9H
  95  102E 01 06 00             LD      BC,6
  96  1031 ED B0                LDIR ; INITIALIZATION OF ROM-A 2
  97  1033 C9                   RET
  98  1034 11 8E 04     DRUGIP:  LD      DE,48EH ; SECOND ATTEMPT: CHECK IF IT'S CORRECTLY RECOGNIZED...
  99  1037 D7                   RST     10H ; WORD 'PRINT', IF IT IS, CHECK WHAT FOLLOWS
 100  1038 20 13                JR      NZ,TRECIP
 101  103A D1                   POP     DE
 102  103B E3                   EX      (SP),HL
 103  103C F1                   POP     AF
 104  103D DF                   RST     18H
 105  103E 25                   DEFB    '%'
 106  103F 0A                   DEFB    KAO48E-$-1
 107  1040 CF                   RST     8
 108  1041 3E 20                LD      A,' ' ; WRITE BLANK
 109  1043 E7                   RST     20H
 110  1044 CD 4C 13             CALL    HEX16B ; WRITE NUMBER IN HEX FORMAT
 111  1047 C3 AD 04             JP      4ADH
 112  104A C3 8E 04     KAO48E:  JP      48EH ; CONTINUES WHERE IT STARTED IF '%' DOESN'T FOLLOW
 113  104D 11 77 07     TRECIP:  LD      DE,777H ; THIRD ATTEMPT: CHECK IF IT TRIED TO RECOGNIZE...
 114  1050 D7                   RST     10H ; ...FUNCTION, BUT FAILED (777H IS ADDRESS...
 115  1051 D1                   POP     DE ; ...TO WHICH IT WOULD JUMP IN THAT CASE)
 116  1052 E3                   EX      (SP),HL
 117  1053 C0                   RET     NZ
 118  1054 21 23 1E             LD      HL,TEXT3-1 ; TABLE OF NEW FUNCTIONS
 119  1057 18 C2                JR      CASE1 ; END IS SAME AS IN FIRST ATTEMPT
 120  1059 C3 77 07     KAO777:  JP      777H
 121  105C 01 80 04     LPRINT:  LD      BC,480H ; 'LPRINT' ENTRY POINT: RET ADDRESS TO 'PRINT'
 122  105F C5                   PUSH    BC ; GOES TO STACK
 123  1060 3E FF        COPY:    LD      A,0FFH ; SETS LPRINT FLAG
 124  1062 32 B5 2B             LD      (FLAG),A
 125  1065 C9                   RET
 126  1066 CD 60 10     LLIST:   CALL    COPY ; 'LLIST' ENTRY POINT: SET FLAG
 127  1069 CD D3 0C             CALL    0CD3H ; CONTINUE AS LLIST
 128  106C C3 64 04             JP      464H
 129  106F F5           VIDEO:   PUSH    AF ; ADDITION TO SUBPROGRAM THAT WRITES CHARACTER TO...
 130  1070 2A B5 2B             LD      HL,(FLAG) ; ...VIDEO MEM (958H, BUT HERE IS CHECKING...
 131  1073 2C                   INC     L ; IS THE FLAG FOR PRINTER SET?
 132  1074 20 21                JR      NZ,NCOPY ; IF NOT, EXIT
 133  1076 21 AB 2A             LD      HL,2AABH ; CHECK IF FLAG IS SET TO NOT WRITE...
 134  1079 CB 46                BIT     0,(HL) ; ...CONTROL CHARS?
 135  107B 20 0E                JR      NZ,STAND ; IF YES, SKIP CHARACTER CHANGE
 136  107D 21 99 10             LD      HL,TABCZS ; IF NOT, POINTER TO TABLE
 137  1080 06 04                LD      B,4 ; TOTAL 4 CHARS FOR COMPARISON
 138  1082 BE           TEST4:   CP      (HL) ; IS THIS THE SEARCHED WORD?
 139  1083 23                   INC     HL
 140  1084 28 04                JR      Z,FOUND4 ; YES, JUMP
 141  1086 23                   INC     HL
 142  1087 10 F9                DJNZ    TEST4 ; TRY NEXT
 143  1089 26                   DEFB    26H ; AS 'LD H,ZEH' - TO SAVE MEMORY...
 144  108A 7E           FOUND4:  LD      A,(HL) ; ...SKIP NEXT WORD
 145  108B F5           STAND:   PUSH    AF ; ...SAVE NEW WORD
 146  108C CD FF 02     RDY:     CALL    2FFH ; 'BREAK' TEST
 147  108F DB FF                IN      A,(255)
 148  1091 17                   RLA
 149  1092 38 F8                JR      C,RDY ; JUMP IF PRINTER IS BUSY
 150  1094 F1                   POP     AF
 151  1095 D3 FF                OUT     (255),A ; PRINTER FREE - SEND CHARACTER
 152  1097 F1           NCOPY:   POP     AF
 153  1098 C9                   RET
 154  1099 5B           TABCZS:  DEFB    91 ; = C caron
 155  109A 43                   DEFB    'C'
 156  109B 5C                   DEFB    92
 157  109C 43                   DEFB    'C' ; = C acute
 158  109D 5D                   DEFB    93
 159  109E 5A                   DEFB    'Z' ; = Z caron
 160  109F 5E                   DEFB    94
 161  10A0 53                   DEFB    'S' ; = S caron
 162  10A1 C3           LINKS:   DEFB    0C3H
 163  10A2 0F 10                DEFW    ZALINK ; CHECK LINE 655 (C3H=JP)
 164  10A4 C3                   DEFB    0C3H
 165  10A5 6F 10                DEFW    VIDEO
 166  10A7 2A 9F 2A     GOASS:   LD      HL,(2A9FH) ; ********** ASSEMBLER **********
 167  10AA 7C                   LD      A,H ; IS IT COMMAND MODE?
 168  10AB B5                   OR      L
 169  10AC CA 5A 06             JP      Z,1626D ; IF YES
 170  10AF EB                   EX      DE,HL ; MAIN POINTER WILL BE HL
 171  10B0 3E 01                LD      A,1 ; SET OPT 1
 172  10B2 32 B3 2B             LD      (OPTION),A
 173  10B5 CD BF 10             CALL    START1 ; CALL PROGRAM FOR ASSEMBLY
 174  10B8 DD 21 AC 2A          LD      IX,2AACH ; RETURN CORRECT VALUE IX REGISTER
 175  10BC 2B                   DEC     HL
 176  10BD EB                   EX      DE,HL ; RETURN POINTER DE
 177  10BE F7                   RST     30H ; GO BACK TO BASIC
 178  10BF AF           START1:  XOR     A
 179  10C0 32 AA 2A             LD      (KRUG),A ; FIRST ASSEMBLY PASS
 180  10C3 32 DD 2B             LD      (INS1),A ; EXECUTE OPCODE TOKEN
 181  10C6 EB                   EX      DE,HL ; SAVE HL IN DE
 182  10C7 EF                   RST     28H ; THIS IS LD HL,0
 183  10C8 22 F6 2B             LD      (DISPL),HL
 184  10CB 22 97 2A             LD      (SHOMEM),HL ; FOR 'REG'; SHOWS 0 BYTES OF MEMORY
 185  10CE 2A 6A 2A             LD      HL,(2A6AH) ; = ENDMEM
 186  10D1 2B                   DEC     HL
 187  10D2 77                   LD      (HL),A ; 0 = TERMINATOR TABLE FOR LABELS
 188  10D3 2B                   DEC     HL
 189  10D4 77                   LD      (HL),A
 190  10D5 EB                   EX      DE,HL ; RETURN HL
 191  10D6 CD 52 17             CALL    FINDCR ; FIND END OF LINE WHERE IS '<'
 192  10D9 E5                   PUSH    HL ; SAVE POINTER FOR SECOND PASS
 193  10DA CD E6 10             CALL    ASS ; FIRST ASSEMBLY PASS
 194  10DD 21 AA 2A             LD      HL,KRUG
 195  10E0 34                   INC     (HL) ; SET SECOND PASS
 196  10E1 AF                   XOR     A
 197  10E2 32 DD 2B             LD      (INS1),A ; EXECUTE OPCODES
 198  10E5 E1                   POP     HL ; RETURN POINTER TO START 1...
 199  10E6 AF           ASS:     XOR     A ; ...ENTER IN SECOND PASS
 200  10E7 32 EC 2B             LD      (TEXTBR),A ; 0 WORDS IN TEXT
 201  10EA 32 EA 2B             LD      (ADDR),A ; ERASE LABEL ADDRESS IN PROGRAM
 202  10ED 32 EB 2B             LD      (ADDR+1),A
 203  10F0              LOOP     EQU     $ ; FOLLOWING 13 LINES ARE MAIN LOOP
 204  10F0 22 9F 2A             LD      (2A9FH),HL ; POSITION OF CURRENT LINE(FOR ERROR CASE)
 205  10F3 ED 5B 38 2C          LD      DE,(2C38H) ; END OF BASIC
 206  10F7 D7                   RST     10H
 207  10F8 D0                   RET     NC ; RETURN IF IT'S END AND NO '>'
 208  10F9 3A DD 2B             LD      A,(INS1)
 209  10FC FE 08                CP      8
 210  10FE C8                   RET     Z ; RETURN IF IT'S '>'
 211  10FF CD FF 02             CALL    2FFH ; 'BREAK' TEST
 212  1102 CD 33 17             CALL    PROG1 ; FIRST PART: PUTTING TOKEN IN TABLE
 213  1105 E5                   PUSH    HL
 214  1106 CD 0C 11             CALL    PROG2 ; SECOND PART: CODE FORMING
 215  1109 E1                   POP     HL
 216  110A 18 E4                JR      LOOP ; BACK TO MAIN LOOP
 217  110C 21 4D 12     PROG2:   LD      HL,GOON ; THIS IS RET ADDRESS FOR END OF SUBROUTINE
 218  110F E5                   PUSH    HL
 219  1110 21 DE 2B             LD      HL,INS2
 220  1113 DD 21 DB 2B          LD      IX,FIELD+3
 221  1117 3A DD 2B             LD      A,(INS1)
 222  111A B7                   OR      A
 223  111B C8                   RET     Z ; NOTHING IN THIS LINE - GO TO GOON
 224  111C FE 09                CP      9 ; IS IT SPECIAL WORD (TOKEN=9)
 225  111E D2 24 13             JP      NC,NCOMM ; NO - NEXT WORD FOR ASSEMBLY
 226  1121 3D                   DEC     A
 227  1122 20 27                JR      NZ,NSTAT ; NOT TOKEN 1
 228  1124 21 78 19             LD      HL,BRKPT ; TOKEN 1: 'REG' (BREAKPOINT)
 229  1127 22 E6 2B             LD      (CODE+1),HL ; BREAKPOINT ADDRESS
 230  112A 3E CD                LD      A,0CDH ; CODE FOR 'CALL'
 231  112C 32 E5 2B             LD      (CODE),A
 232  112F 3E 03                LD      A,3
 233  1131 32 E9 2B             LD      (CODE+4),A ; 3 BYTES CODED LENGTH
 234  1134 2A DF 2B             LD      HL,(INS2+1) ; IS THERE MEMORY DISPLAY?
 235  1137 7C                   LD      A,H
 236  1138 B5                   OR      L
 237  1139 C8                   RET     Z ; NO - GO TO GOON
 238  113A CD 1B 13             CALL    IFNUM2 ; IS IT NUMERIC VALUE (IF NOT-WHAT?)
 239  113D 22 97 2A             LD      (SHOMEM),HL ; SHOW HL MEMORY
 240  1140 3A E2 2B             LD      A,(INS3+1) ; HOW MANY ROWS?
 241  1143 B7                   OR      A
 242  1144 20 01                JR      NZ,IMA ; NUMBER OF ROWS SPECIFIED
 243  1146 3C                   INC     A ; NOT SPECIFIED - THEN 1 ROW
 244  1147 32 B2 2B     IMA:     LD      (SHOFOR),A ; = SHOW FORMAT
 245  114A C9                   RET
 246  114B 3D           NSTAT:   DEC     A
 247  114C 20 21                JR      NZ,NTEXT ; NOT TOKEN 2
 248  114E 7E                   LD      A,(HL) ; TOKEN 2: 'TEXT'
 249  114F 32 EC 2B             LD      (TEXTBR),A ; NUMBER OF TEXT WORDS
 250  1152 11 E5 2B             LD      DE,CODE
 251  1155 06 03        TEXTIT:  LD      B,3 ; 3 BYTES IN ONE ROW
 252  1157 3A EC 2B     TXT4:    LD      A,(TEXTBR) ; HOW MANY WORDS LEFT?
 253  115A B7                   OR      A
 254  115B C8                   RET     Z ; NONE - GO TO GOON
 255  115C DD 35 11             DEC     (IX+17) ; DECREASE WORD COUNT
 256  115F 2A DF 2B             LD      HL,(INS2+1) ; TEXT ADDRESS IN PROGRAM
 257  1162 7E                   LD      A,(HL) ; TAKE WORD OR CHARACTER
 258  1163 23                   INC     HL ; INCREASE POINTER
 259  1164 22 DF 2B             LD      (INS2+1),HL ; AND RETURN IT
 260  1167 12                   LD      (DE),A ; PUT CHARACTER IN CODE
 261  1168 13                   INC     DE ; INCREASE CODE POINTER
 262  1169 DD 34 0E             INC     (IX+14) ; INCREASE BYTE COUNT
 263  116C 10 E9                DJNZ    TXT4 ; DO THIS 3 TIMES IN EACH ROW
 264  116E C9                   RET ; GO TO GOON
 265  116F 3D           NTEXT:   DEC     A
 266  1170 20 04                JR      NZ,NWORD ; NOT TOKEN 3
 267  1172 3C                   INC     A ; TOKEN 3: 'WORD'
 268  1173 DD 77 0E             LD      (IX+14),A ; BYTE COUNT=1 (AND ON 5120 WILL BE +1)
 269  1176 3D           NWORD:   DEC     A
 270  1177 20 0C                JR      NZ,NBYTE ; NOT TOKEN 4 OR 3
 271  1179 CD 18 13             CALL    IFNUM1 ; TOKEN 4: 'BYTE'
 272  117C 2A DF 2B             LD      HL,(INS2+1) ; TAKE CODE
 273  117F 22 E5 2B             LD      (CODE),HL ; PUT IT IN ITS PLACE
 274  1182 C3 48 13             JP      IXGOON ; SEE 5120
 275  1185 3D           NBYTE:   DEC     A
 276  1186 20 23                JR      NZ,NOPT ; NOT TOKEN 5
 277  1188 CD 1B 13             CALL    IFNUM2 ; TOKEN 5: 'OPT' (IF >255, WHAT)
 278  118B 2A DF 2B             LD      HL,(INS2+1) ; TAKE NUMBER OPTION
 279  118E 7D                   LD      A,L ; U A REG
 280  118F E6 04                AND     4 ; IF BIT 2 IS SET (4-5-6-7)
 281  1191              ;new page
 282  1191 C4 60 10             CALL NZ,COPY ; SET FLAG FOR PRINTER
 283  1194 7D                   LD A,L
 284  1195 E6 03                AND 3
 285  1197 32 B3 2B             LD (OPTION),A ; MASK TO BE LESS THAN 4
 286  119A 3A E1 2B             LD A,(INS3)
 287  119D B7                   OR A ; IS RELOCATION REQUESTED ON WRITE?
 288  119E C8                   RET Z ; NO - GO TO GOON
 289  119F FE 40                CP 40H
 290  11A1 C2 2D 19             JP NZ,WHATHL ; NOT NUMERIC - ERROR
 291  11A4 2A E2 2B             LD HL,(INS3+1) ; RELOCATION SIZE...
 292  11A7 22 F6 2B             LD (DISPL),HL ; ...TO ITS PLACE
 293  11AA C9                   RET
 294  11AB 3D           NOPT:    DEC A
 295  11AC 20 0D                JR NZ,NORG ; NOT TOKEN 6
 296  11AE CD 18 13             CALL IFNUM1 ; TOKEN 6: 'ORG'
 297  11B1 2A DF 2B             LD HL,(INS2+1)
 298  11B4 22 ED 2B             LD (TEMP1),HL ; TEMPORARY ADDRESS
 299  11B7 22 EA 2B     SKR4:    LD (ADDR),HL ; MAIN POINTER OF PC ADDRESS
 300  11BA C9                   RET
 301  11BB 3D           NORG:    DEC A
 302  11BC C0                   RET NZ ; END = TOKEN 8 '>'
 303  11BD CD 18 13             CALL IFNUM1 ; TOKEN 7: 'EQU'
 304  11C0 ED 4B DF 2B          LD BC,(INS2+1)
 305  11C4 ED 43 ED 2B          LD (TEMP1),BC ; LABEL ADDRESS
 306  11C8 CD D2 11             CALL CREATE ; FORM LABEL
 307  11CB CA 2D 19             JP Z,WHATHL ; IF NOT PROVIDED - WHAT
 308  11CE F1                   POP AF ; RESTORE STACK - WON'T GO TO GOON
 309  11CF C3 54 12             JP GOON1 ; BUT TO GOON1
 310  11D2 3A AA 2A     CREATE:  LD A,(KRUG) ; ---- LABEL FORMATION ----
 311  11D5 B7                   OR A
 312  11D6 C0                   RET NZ ; CANNOT BE FORMED IN SECOND PASS
 313  11D7 2A DA 2B             LD HL,(FIELD+2)
 314  11DA 7C                   LD A,H
 315  11DB B5                   OR L
 316  11DC C8                   RET Z ; RETURN IF LABEL ADDRESS DOESN'T EXIST
 317  11DD CD 15 12             CALL LOCAT2 ; CHECK IF IT'S ALREADY FORMED
 318  11E0 CA 4F 16             JP Z,HOWHL ; IF IT EXISTS - CANNOT BE FORMED TWICE (HOW?)
 319  11E3 E5           TRANSF:  PUSH HL
 320  11E4 2A 38 2C             LD HL,(2C38H) ; END OF BASIC PROGRAM
 321  11E7 D7                   RST 10H
 322  11E8 E1                   POP HL
 323  11E9 D2 53 01             JP NC,339D ; SORRY - NO MEMORY
 324  11EC 7E                   LD A,(HL)
 325  11ED 12                   LD (DE),A ; TRANSFER LETTER BY LETTER TO TABLE
 326  11EE 23                   INC HL
 327  11EF 1B                   DEC DE
 328  11F0 CD 50 18             CALL NCSLBR ; IF LETTER OR NUMBER
 329  11F3 30 EE                JR NC,TRANSF ; ...CONTINUE WITH TRANSFER
 330  11F5 EB           NOTRAN:  EX DE,HL
 331  11F6 23                   INC HL
 332  11F7 CB FE                SET 7,(HL) ; WORD TERMINATOR = BIT 7 SET
 333  11F9 2B                   DEC HL
 334  11FA 70                   LD (HL),B ; BC = LABEL VALUE
 335  11FB 2B                   DEC HL
 336  11FC 71                   LD (HL),C
 337  11FD 2B                   DEC HL
 338  11FE 36 00                LD (HL),0 ; TABLE TERMINATOR
 339  1200 EB                   EX DE,HL ; HL = POINTER NOW BEHIND NAME
 340  1201 AF                   XOR A ; RESET Z FLAG (SIGN THAT EVERYTHING IS OK)
 341  1202 3C                   INC A ; NEW POSITION IN TABLE
 342  1203 C9                   RET
 343  1204              ;new page
 344  1204 3A AA 2A     LOCATE:  LD    A,(KRUG) ; ---- LOOP LABEL ----
 345  1207 B7                   OR    A
 346  1208 20 0B                JR    NZ,LOCAT2 ; ONLY IN SECOND LOOP
 347  120A 2B                   DEC   HL ; AND IN 1. LOOP JUST SKIP NAME
 348  120B 23           SRC20H:  INC   HL
 349  120C CD 50 18             CALL  NCSLBR
 350  120F 30 FA                JR    NC,SRC20H
 351  1211 AF                   XOR   A
 352  1212 47                   LD    B,A
 353  1213 4F                   LD    C,A
 354  1214 C9                   RET
 355  1215 E5           LOCAT2:  PUSH  HL
 356  1216 D9                   EXX
 357  1217 2A 6A 2A             LD    HL,(2A6AH) ; END OF MEMORY (START OF COMPARISON)
 358  121A 2B                   DEC   HL
 359  121B 18 12                JR    IFF1R ; START
 360  121D D1           GOSRCH:  POP   DE ; RECONSTRUCT POINTER
 361  121E D5                   PUSH  DE
 362  121F 1A           GOSRC2:  LD    A,(DE) ; TAKE FROM PROGRAM TEXT
 363  1220 BE                   CP    (HL) ; AND COMPARE WITH LABEL LIST
 364  1221 28 16                JR    Z,FOUNDV ; ONE WORD MATCHES
 365  1223 F6 80                OR    80H ; SET BIT 7 (AS IN THE LAST CHARACTER)
 366  1225 BE                   CP    (HL) ; AND COMPARE AGAIN (MAYBE IT'S THE END)
 367  1226 28 15                JR    Z,BASFDU ; STILL - SUCCESSFUL COMPARISON
 368  1228 CB 7E        SRCHV:   BIT   7,(HL) ; NO - FIND END OF THIS NAME IN LIST
 369  122A 2B                   DEC   HL
 370  122B 28 FB                JR    Z,SRCHV ; NOT THE END YET
 371  122D 2B                   DEC   HL ; SKIP VALUE IN LIST
 372  122E 2B                   DEC   HL ; ONE MORE BYTE
 373  122F 7E           IFF1R:   LD    A,(HL) ; NEXT NAME (FIRST CHARACTER)
 374  1230 B7                   OR    A ; MAYBE IT'S NULL (TERMINATOR TABLE)?
 375  1231 20 EA                JR    NZ,GOSRCH ; NO - CONTINUE COMPARISON
 376  1233 E5                   PUSH  HL ; TRANSFER HL TO DE
 377  1234 D9                   EXX ; ...OF ALTERNATIVE SET
 378  1235 D1                   POP   DE ; DE = NEW POSITION IN TABLE
 379  1236 E1                   POP   HL ; RECONSTRUCT HL
 380  1237 3C                   INC   A ; A=1 (SIGN THAT NAME NOT FOUND)
 381  1238 C9                   RET
 382  1239 2B           FOUNDV:  DEC   HL ; COMPARISON GOING WELL
 383  123A 13                   INC   DE ; GO TO NEW CHARACTER
 384  123B 18 E2                JR    GOSRC2 ; CONTINUE COMPARISON
 385  123D 13           BASFDU:  INC   DE ; GO TO NEW CHARACTER IN PROGRAM
 386  123E EB                   EX    DE,HL
 387  123F CD 50 18             CALL  NCSLBR ; IF IT'S WORD OR NUMBER, RESET CARRY
 388  1242 EB                   EX    DE,HL
 389  1243 30 E3                JR    NC,SRCHV ; SO SAY LONG-NO SUCCESSFUL COMPARISON
 390  1245 2B                   DEC   HL ; FULLY SUCCESSFUL COMPARISON; GO TO VALUE
 391  1246 46                   LD    B,(HL) ; HIGH BYTE
 392  1247 2B                   DEC   HL
 393  1248 4E                   LD    C,(HL) ; BC = VALUE
 394  1249 EB                   EX    DE,HL ; HL = POINTER TO NAME
 395  124A D1                   POP   DE ; DE = START POINTER
 396  124B AF                   XOR   A ; A = 0 (SIGN THAT NAME IS FOUND IN LIST)
 397  124C C9                   RET
 398  124D ED 4B EA 2B  GOON:    LD    BC,(ADDR) ; ---- END OF PROCESSING ONE WORD ----

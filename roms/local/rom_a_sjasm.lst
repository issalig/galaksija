3097  083D              ; 'PRINT A FLOATING POINT NUMBER (cont.)'
3098  083D              ; =======================================
3099  083D              ; Prints a floating point number on the top of the arithmetic stack at the
3100  083D              ; current cursor position. Number must not be zero.
3101  083D
3102  083D              ; IX Offset	-5	-4	-3	-2	-1
3103  083D              ; ---------------------------------------------------
3104  083D              ;		24 bit mantissa	(MSB)	Exp	Sign
3105  083D
3106  083D              ;; PRINTFP_DO
3107  083D
3108  083D
3109  083D              ; First print the sign character and make the floating point number positive.
3110  083D
3111  083D              l083dh:
3112  083D DD 7E FF     	ld a,(ix-1)	;083d	Load sign bit into A
3113  0840 A7           	and a		;0840

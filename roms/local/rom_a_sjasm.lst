2458  068E              ; 'EVALUATE ARITHMETIC OPERATORS'
2459  068E              ; ===============================
2460  068E              ; Evaluates an arithmetic expression at DE and returns its value on arithmetic
2461  068E              ; stack.
2462  068E
2463  068E              ;; EVAL_ARITHMETIC
2464  068E              l068eh:
2465  068E
2466  068E              ; Start by checking for a leading "+" or "-" character.
2467  068E
2468  068E DF           	rst 18h		;068e	Call READ_PAR
2469  068F 2D           	db '-'		;068f
2470  0690 06           	db l0697h-$-1	;0690
2471  0691
2472  0691              ; Leading "-" sign - add an implicit 0 to arithmetic stack and jump to
2473  0691              ; subtraction.
2474  0691
2475  0691 EF           	rst 28h		;0691	Call CLEAR_HL
2476  0692 CD BC 0A     	call l0abch	;0692	Call INT_TO_FP
2477  0695 18 14        	jr l06abh	;0695	Jump to subtraction
2478  0697
2479  0697              l0697h:
2480  0697 DF           	rst 18h		;0697	Call READ_PAR
2481  0698 2B           	db '+'		;0698
2482  0699 00           	db 000h		;0699
2483  069A
2484  069A              ; Ignore a leading plus sign. Load level 2 value to arithmetic stack.
2485  069A
2486  069A CD B3 06     	call l06b3h	;069a	Call EVAL_LVL2
2487  069D
2488  069D              ; Level 1 - Evaluation of addition and subtraction
2489  069D
2490  069D              ;; EVAL_LVL1
2491  069D              l069dh:
2492  069D DF           	rst 18h		;069d	Call READ_PAR
2493  069E 2B           	db '+'		;069e
2494  069F 08           	db l06a8h-$-1	;069f
2495  06A0
2496  06A0              ; Addition. Load a value from level 2 and add them together
2497  06A0
2498  06A0 CD B3 06     	call l06b3h	;06a0	Call EVAL_LVL2
2499  06A3 CD 32 0B     	call l0b32h	;06a3	Call FP_ADD
2500  06A6 18 F5        	jr l069dh	;06a6	Jump back to EVAL_LVL1
2501  06A8
2502  06A8              l06a8h:
2503  06A8 DF           	rst 18h		;06a8	Call READ_PAR
2504  06A9 2D           	db '-'		;06a9
2505  06AA DF           	db l078ah-$-1	;06aa	Return if operand is neither "+" nor "-"
2506  06AB
2507  06AB              ; Subtraction. Load a value from level 2 and add them together
2508  06AB
2509  06AB              l06abh:
2510  06AB CD B3 06     	call l06b3h	;06ab	Call EVAL_LVL2
2511  06AE CD 1E 0B     	call l0b1eh	;06ae	Call FP_SUB
2512  06B1 18 EA        	jr l069dh	;06b1	Jump back to EVAL_LVL1
2513  06B3
2514  06B3              ; Level 2 - Evaluation of multiplication and division
2515  06B3
2516  06B3              ;; EVAL_LVL2
2517  06B3              l06b3h:
2518  06B3 CD 93 03     	call l0393h	;06b3	Call EVAL_FUNCTIONS
2519  06B6              l06b6h:
2520  06B6 DF           	rst 18h		;06b6	Call READ_PAR
2521  06B7 2A           	db '*'		;06b7
2522  06B8 08           	db l06c1h-$-1	;06b8
2523  06B9
2524  06B9              ; Multiplication
2525  06B9
2526  06B9 CD 93 03     	call l0393h 	;06b9	Call EVAL_FUNCTIONS
2527  06BC CD E6 0A     	call l0ae6h	;06bc	Call FP_MUL
2528  06BF 18 F5        	jr l06b6h	;06bf	Return back to level 2 evaluation
2529  06C1
2530  06C1              l06c1h:
2531  06C1 DF           	rst 18h		;06c1	Call READ_PAR
2532  06C2 2F           	db '/'		;06c2
2533  06C3 C6           	db l078ah-$-1 	;06c3	Return if operand is neither "+" nor "-"
2534  06C4
2535  06C4              ; Division
2536  06C4
2537  06C4 CD 93 03     	call l0393h	;06c4	Call EVAL_FUNCTIONS
2538  06C7 CD F7 0A     	call l0af7h	;06c7	Call FP_DIV
2539  06CA 18 EA        	jr l06b6h	;06ca	Return back to level 2 evaluation
2540  06CC
2541  06CC              ; 'UNDOT'
2542  06CC              ; =======
2543  06CC              ; "UNDOT" BASIC command.
2544  06CC
2545  06CC              ;; UNDOT
2546  06CC              l06cch:
2547  06CC 3E 01        	ld a,001h	;06cc	Load 01h into A (Zf = 0, Sf = 0)
2548  06CE
2549  06CE 01           	db 001h		;06ce	Dummy ld bc,nn (skip next instruction)
2550  06CF
2551  06CF              ; 'DOT'
2552  06CF              ; =====
2553  06CF              ; "DOT" BASIC command.
2554  06CF
2555  06CF              ;; DOT
2556  06CF              l06cfh:
2557  06CF 3E 80        	ld a,080h	;06cf	Load 80h into A (Zf = 0, Sf = 1)
2558  06D1
2559  06D1 F5           	push af		;06d1	Store AF on stack
2560  06D2
2561  06D2 DF           	rst 18h		;06d2	Call READ_PAR
2562  06D3 2A           	db '*'		;06d3
2563  06D4 05           	db l06dah-$-1	;06d4
2564  06D5
2565  06D5              ; DOT* and UNDOT* versions of command: turn clock on or off
2566  06D5
2567  06D5 F1           	pop af		;06d5	Restore AF from stack
2568  06D6
2569  06D6 32 AF 2B     	ld (02bafh),a	;06d6	Store A into CLOCK_ON
2570  06D9 F7           	rst 30h		;06d9	Continue with the next command (call BASIC_NEXT)
2571  06DA
2572  06DA              l06dah:
2573  06DA F1           	pop af		;06da	Restore AF from stack
2574  06DB 06           	db 006h		;06db	Dummy "ld b,nn" (skip next two commands so that
2575  06DC              			;	flags remain unchanged)
2576  06DC
2577  06DC              ; 'DOT FUNCTION'
2578  06DC              ; ==============
2579  06DC              ; "DOT" BASIC function.
2580  06DC
2581  06DC              ;; DOT_FUNC
2582  06DC              l06dch:
2583  06DC AF           	xor a		;06dc	Clear A, set Zf and clear Sf
2584  06DD A7           	and a		;06dd
2585  06DE
2586  06DE              ; Meaning of flags at this point:
2587  06DE              ;
2588  06DE              ; Zf	Sf	function
2589  06DE              ; -----------------------------------------
2590  06DE              ; 1	x	Query pixel (DOT function)
2591  06DE              ; 0	0	Clear pixel (UNDOT command)
2592  06DE              ; 0	1	Draw pixel  (DOT command)
2593  06DE
2594  06DE F5           	push af		;06de	Save A on stack
2595  06DF
2596  06DF CF           	rst 8		;06df	Get X coordinate (call EVAL_INT_EXP)
2597  06E0 E5           	push hl		;06e0	Save X on stack
2598  06E1
2599  06E1 CD 05 00     	call l0005h	;06e1	Get Y coordinate (call EVAL_INT_EXP_NEXT)
2600  06E4 D5           	push de		;06e4	Save DE on stack
2601  06E5 EB           	ex de,hl	;06e5	Move Y to DE (actually E, since Y < 48)
2602  06E6
2603  06E6 01 20 00     	ld bc,32	;06e6	Load 32 into BC
2604  06E9
2605  06E9 1C           	inc e		;06e9	Increment E
2606  06EA 21 00 28     	ld hl,02800h	;06ea	Load VIDEO_MEM into HL
2607  06ED
2608  06ED              ; HL = 2800h + 32 * (E / 3)
2609  06ED              ; A = 1 << (E % 3)
2610  06ED
2611  06ED              ;; DOT_DIV_3_LOOP
2612  06ED              l06edh:
2613  06ED 16 03        	ld d,3		;06ed	Load 3 into D
2614  06EF 3E 01        	ld a,1		;06ef	Load 1 into A
2615  06F1
2616  06F1              ;; DOT_DIV_1_LOOP
2617  06F1              l06f1h:
2618  06F1 1D           	dec e		;06f1	Decrement E
2619  06F2 28 0A        	jr z,l06feh	;06f2	Break from loop if E = 0
2620  06F4
2621  06F4 07           	rlca		;06f4	Rotate A left 2 times
2622  06F5 07           	rlca		;06f5
2623  06F6
2624  06F6 15           	dec d		;06f6	Decrement D, loop to DOT_DIV_1_LOOP if not zero
2625  06F7 20 F8        	jr nz,l06f1h	;06f7
2626  06F9
2627  06F9 09           	add hl,bc	;06f9	Add 32 to HL for each 3 decrements of E
2628  06FA CB 8C        	res 1,h		;06fa	HL = HL & 01ff
2629  06FC 18 EF        	jr l06edh	;06fc	Loop to DOT_DIV_3_LOOP
2630  06FE
2631  06FE              ; HL contains address of the character line that holds the required graphics
2632  06FE              ; coordinates.
2633  06FE
2634  06FE              l06feh:
2635  06FE 47           	ld b,a		;06fe	Save A to B (?)
2636  06FF D1           	pop de		;06ff	Restore DE from stack
2637  0700
2638  0700 E3           	ex (sp),hl	;0700	Save line address to stack, move X to HL
2639  0701
2640  0701 CB BD        	res 7,l		;0701	X = X & 001f
2641  0703 CB B5        	res 6,l		;0703
2642  0705
2643  0705 CB 3D        	srl l		;0705	X = X / 2
2644  0707
2645  0707 30 01        	jr nc,l070ah	;0707	Shift A left if X odd
2646  0709 07           	rlca		;0709
2647  070A              l070ah:
2648  070A
2649  070A 26 00        	ld h,000h	;070a	Clear H
2650  070C
2651  070C C1           	pop bc		;070c	Get line address from stack
2652  070D 09           	add hl,bc	;070d	Add X / 2.
2653  070E
2654  070E 47           	ld b,a		;070e	Save A to B
2655  070F
2656  070F F1           	pop af		;070f	Restore flags from stack
2657  0710 78           	ld a,b		;0710
2658  0711
2659  0711              ; HL now contains the address of the character, A contains the bitmask.
2660  0711
2661  0711 20 0C        	jr nz,l071fh	;0711	If Zf not set, jump to DOT_DRAW_OR_CLEAR
2662  0713
2663  0713              ; Check if pixel is set and return a floating point value 1 or 0
2664  0713
2665  0713 CB 7E        	bit 7,(hl)	;0713	If (HL) is not graphics character (bit 7 not
2666  0715 28 01        	jr z,l0718h	;0715	set), jump over and return 0.
2667  0717
2668  0717 A6           	and (hl)	;0717	Check if bit in A is set in (HL)
2669  0718              l0718h:
2670  0718 EF           	rst 28h		;0718	Call CLEAR_HL
2671  0719
2672  0719 28 01        	jr z,l071ch	;0719	If bit was set HL = 1 else HL = 0
2673  071B 23           	inc hl		;071b

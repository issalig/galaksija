1199  024F              ; 'ADD A DECIMAL NUMBER TO MANTISSA'
1200  024F              ; ==================================
1201  024F              ; Multiplies floating point number's mantissa in HL' C' by 10 and adds integer
1202  024F              ; in A to it.
1203  024F
1204  024F              ; Parameters:
1205  024F              ;	HL' C': Input mantissa (24 bit)
1206  024F              ;	A: Integer to add
1207  024F              ; Returns:
1208  024F              ;	HL' BC': Output mantissa (32 bit)
1209  024F              ;	DE' A': Unmodified input mantissa (24 bit)
1210  024F              ;	Zf: Set if B' is zero
1211  024F
1212  024F              ;; FP_MUL_10_ADD_A
1213  024F              l024fh:
1214  024F 08           	ex af,af'	;024f
1215  0250 D9           	exx		;0250
1216  0251
1217  0251 54           	ld d,h		;0251	DE' A' = HL' C'
1218  0252 5D           	ld e,l		;0252
1219  0253 79           	ld a,c		;0253
1220  0254
1221  0254 06 00        	ld b,000h	;0254	Clear B'
1222  0256
1223  0256 F5           	push af		;0256	Push AF' on stack
1224  0257
1225  0257              ;		L'	H'	C'	B'	L	H
1226  0257              ; ----------------------------------------------------------
1227  0257              ;		32 bit mantissa		(MSB)	Exp	Sign
1228  0257
1229  0257 29           	add hl,hl	;0257	HL' BC' = HL' BC' * 2
1230  0258 CB 11        	rl c		;0258
1231  025A CB 10        	rl b		;025a
1232  025C
1233  025C 29           	add hl,hl	;025c	HL' C' = HL' C' * 2
1234  025D CB 11        	rl c		;025d
1235  025F CB 10        	rl b		;025f
1236  0261
1237  0261 19           	add hl,de	;0261	HL' BC' = HL' BC' + DE' A'
1238  0262 89           	adc a,c		;0262
1239  0263 4F           	ld c,a		;0263
1240  0264
1241  0264 3E 00        	ld a,000h	;0264
1242  0266 88           	adc a,b		;0266
1243  0267 47           	ld b,a		;0267
1244  0268
1245  0268              ; We now have HL' BC' = HL' BC' * 5
1246  0268
1247  0268 F1           	pop af		;0268	Pop AF' from stack
1248  0269
1249  0269 D5           	push de		;0269	Push DE' to stack
1250  026A
1251  026A 16 00        	ld d,000h	;026a	Clear D'
1252  026C
1253  026C 29           	add hl,hl	;026c	HL' BC' = HL' BC' * 2
1254  026D CB 11        	rl c		;026d
1255  026F CB 10        	rl b		;026f
1256  0271
1257  0271              ; We now have HL' BC' = HL' BC' * 10
1258  0271
1259  0271 08           	ex af,af'	;0271	Exchange AF with AF'
1260  0272
1261  0272 5F           	ld e,a		;0272	Load A into E'
1262  0273
1263  0273 19           	add hl,de	;0273	HL' BC' = HL' BC' + E'
1264  0274
1265  0274 7A           	ld a,d		;0274
1266  0275 89           	adc a,c		;0275
1267  0276 4F           	ld c,a		;0276
1268  0277
1269  0277 7A           	ld a,d		;0277
1270  0278 88           	adc a,b		;0278
1271  0279 47           	ld b,a		;0279
1272  027A
1273  027A D1           	pop de		;027a	Pop DE' from stack
1274  027B
1275  027B D9           	exx		;027b
1276  027C C9           	ret		;027c	Return

2713  073B              ; 'POP FLOATING POINT NUMBER FROM STACK'
2714  073B              ; ======================================
2715  073B              ; Fetches a floating point number from the top of the arithmetic stack and
2716  073B              ; stores it in 4-byte format at (HL).
2717  073B
2718  073B              ; IX Offset	0	1	2	3	4
2719  073B              ; ---------------------------------------------------
2720  073B              ;		24 bit mantissa	(MSB)	Exp	Sign
2721  073B
2722  073B              ; IX Offset	0        1        2	   3        4
2723  073B              ; -------------------------------------------------------------
2724  073B              ;		MMMMMMMM MMMMMMMM 1MMMMMMM EEEEEEEE S0000000
2725  073B              ;		(LSB)		  (MSB)
2726  073B
2727  073B              ; HL Offset	0        1        2	   3
2728  073B              ; --------------------------------------------------
2729  073B              ;		MMMMMMMM MMMMMMMM EMMMMMMM SEEEEEEE
2730  073B              ;		(LSB)		  (MSB)
2731  073B
2732  073B              ;; POP_FP
2733  073B              l073bh:
2734  073B CD 0E 09     	call l090eh	;073b	Call SUB_IX_5
2735  073E
2736  073E 01 04 00     	ld bc,0004h	;073e	Load 4 into BC
2737  0741 D5           	push de		;0741	Save HL and DE to stack
2738  0742 E5           	push hl		;0742
2739  0743
2740  0743 EB           	ex de,hl	;0743	Store HL to DE
2741  0744 DD E5        	push ix		;0744   Store IX to HL
2742  0746 E1           	pop hl		;0746
2743  0747
2744  0747 ED B0        	ldir		;0747	Transfer 4 bytes from (IX) to (HL)
2745  0749              			;	DE = DE_orig + 4
2746  0749
2747  0749 EB           	ex de,hl	;0749	Restore HL and DE
2748  074A
2749  074A 2B           	dec hl		;074a	HL = HL_orig + 2
2750  074B 2B           	dec hl		;074b
2751  074C CB 16        	rl (hl)		;074c	Rotate left (HL_orig + 2)
2752  074E
2753  074E 23           	inc hl		;074e	HL = HL_orig + 3
2754  074F DD 7E 04     	ld a,(ix+4)	;074f	Sign bit to Cf
2755  0752 17           	rla		;0752
2756  0753 CB 1E        	rr (hl)		;0753	Store sign bit to MSB of (HL_orig + 3)
2757  0755              			;	LSB of exponent to Cf.
2758  0755
2759  0755 2B           	dec hl		;0755	HL = HL_orig + 2
2760  0756 CB 1E        	rr (hl)		;0756	Store LSB of exponent in MSB of (HL_orig + 2)
2761  0758
2762  0758 E1           	pop hl		;0758	Restore HL and DE from stack
2763  0759 D1           	pop de		;0759
2764  075A C9           	ret		;075a	Return
2765  075B

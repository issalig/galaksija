 710  0125              ; 'LOCATE BASIC NUMERIC VARIABLE'
 711  0125              ; ===============================
 712  0125              ; Locates a BASIC variable containing 4-byte floating point number and stores
 713  0125              ; its address in HL.
 714  0125
 715  0125              ; Recognizes ordinary variables from A - Z and A(I) array.
 716  0125
 717  0125              ; Returns:
 718  0125              ;	HL: Location of the variable
 719  0125
 720  0125              ;; LOCATE_VARIABLE
 721  0125              l0125h:
 722  0125 CD 05 01     	call l0105h	;0125	Fetch the next character (call EAT_SPACE)
 723  0128
 724  0128              ; Return with Cf set if character not between 'A' and 'Z'
 725  0128
 726  0128 D6 41        	sub 041h	;0128	Subtract ASCII value 'A'
 727  012A D8           	ret c		;012a	Return if less
 728  012B
 729  012B FE 1A        	cp 01ah		;012b 	Compare character with ASCII value 'Z' + 1
 730  012D 3F           	ccf		;012d
 731  012E D8           	ret c		;012e	Return if greater or equal
 732  012F
 733  012F 13           	inc de		;012f	Move to the next character
 734  0130 A7           	and a		;0130
 735  0131 20 2B        	jr nz,l015eh	;0131	Jump to LOCATE_VARIABLE_BZ if character
 736  0133              			;	is not A
 737  0133
 738  0133 DF           	rst 18h		;0133	Call READ_PAR
 739  0134 28           	db '('		;0134
 740  0135 27           	db l015dh-$-1	;0135	Jump to LOCATE_VARIABLE_A if character A is
 741  0136              			;	not followed by '('
 742  0136
 743  0136              ; A(I) array
 744  0136
 745  0136 CF           	rst 8		;0136 	HL = index (call EVAL_INT_EXP)
 746  0137 23           	inc hl		;0137	Increment index
 747  0138
 748  0138 29           	add hl,hl	;0138	HL = index * 4
 749  0139 29           	add hl,hl	;0139
 750  013A
 751  013A D5           	push de		;013a	Save DE on stack
 752  013B 38 17        	jr c,l0154h	;013b	Jump to SORRY_RST on carry (index too large)
 753  013D
 754  013D ED 5B 99 2A  	ld de,(02a99h)	;013d	HL = index * 4 + ARRAY_LEN
 755  0141 19           	add hl,de	;0141
 756  0142
 757  0142 D1           	pop de		;0142	Fetch DE from stack
 758  0143 D5           	push de		;0143
 759  0144
 760  0144 38 0D        	jr c,l0153h	;0144	Jump to SORRY_RST_PUSH_DE on carry
 761  0146              			;	(index too large)
 762  0146              l0146h:
 763  0146 D1           	pop de		;0146	Restore DE
 764  0147
 765  0147 DF           	rst 18h		;0147	Call READ_PAR
 766  0148 29           	db ')'		;0148
 767  0149 09           	db l0153h-$-1	;0149	Jump to SORRY_RST_PUSH_DE if no closing ')'
 768  014A              			;	found.
 769  014A
 770  014A D5           	push de		;014a	Save DE
 771  014B
 772  014B EB           	ex de,hl	;014b	DE = index * 4 + ARRAY_LEN
 773  014C CD 83 01     	call l0183h	;014c	Call FREE_MEM
 774  014F
 775  014F D7           	rst 10h		;014f	Call CMP_HL_DE
 776  0150
 777  0150 30 36        	jr nc,l0188h	;0150	Jump to SUB_RAMTOP_HL if enough memory and
 778  0152              			;	return
 779  0152
 780  0152 3E           	db 03eh		;0152	Dummy ld a,nn (ignore push de command)
 781  0153
 782  0153              ; '"SORRY" ERROR RESTART'
 783  0153              ; =======================
 784  0153              ; This restart is called when there is not enough memory available to
 785  0153              ; complete a function or command.
 786  0153
 787  0153              ;; SORRY_RST_PUSH_DE
 788  0153              l0153h:
 789  0153 D5           	push de		;0153	Push current parser address to stack.
 790  0154              ;; SORRY_RST
 791  0154              l0154h:
 792  0154 CD 99 07     	call l0799h		;0154	Call BASIC_ERROR
 793  0157 53 4F 52 52  	dm "SORRY", 00dh	;0157
 793  015B 59 0D
 794  015D
 795  015D              ; Ordinary variable
 796  015D
 797  015D              ;; LOCATE_VARIABLE_A
 798  015D              l015dh:
 799  015D AF           	xor a		;015d	Clear A
 800  015E              ;; LOCATE_VARIABLE_BZ

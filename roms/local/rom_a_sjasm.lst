2993  07F6              ; 'FIND BASIC LINE IN SCOPE'
2994  07F6              ; ==========================
2995  07F6              ; Finds BASIC line with line number equal or greater than HL, starting at DE.
2996  07F6              ; If line number was not found after DE, Cf is set.
2997  07F6
2998  07F6              ; Parameters:
2999  07F6              ;	DE: Pointer to the start of a BASIC line where the search starts.
3000  07F6              ;	HL: Line number to find.
3001  07F6              ; Returns:
3002  07F6              ;	DE: Pointer to the start of the BASIC line if a matching line number
3003  07F6              ;           is found
3004  07F6              ;	Cf: Set if line number was not found.
3005  07F6              ;	Zf: Set if line number found is equal to HL.
3006  07F6
3007  07F6              ;; FIND_LINE_SCOPE
3008  07F6              l07f6h:
3009  07F6 E5           	push hl		;07f6	Save HL on stack
3010  07F7
3011  07F7              ; Check if DE is within the expected margins of the BASIC program.
3012  07F7
3013  07F7 2A 36 2C     	ld hl,(02c36h)	;07f7	Load BASIC_START-1 into HL
3014  07FA 2B           	dec hl		;07fa
3015  07FB
3016  07FB D7           	rst 10h		;07fb	(call CMP_HL_DE)
3017  07FC D2 17 03     	jp nc,l0317h	;07fc	Jump to RESET_BASIC_2 if DE < BASIC_START
3018  07FF
3019  07FF 2A 38 2C     	ld hl,(02c38h)	;07ff	Load BASIC_END-1 into HL
3020  0802 2B           	dec hl		;0802
3021  0803
3022  0803 D7           	rst 10h		;0803	(call CMP_HL_DE)
3023  0804
3024  0804 E1           	pop hl		;0804	Restore HL
3025  0805
3026  0805 D8           	ret c		;0805	Return if DE >= BASIC_END
3027  0806
3028  0806 1A           	ld a,(de)	;0806	Subtract HL from 16-bit line number at (DE)
3029  0807 95           	sub l		;0807
3030  0808 47           	ld b,a		;0808
3031  0809 13           	inc de		;0809
3032  080A 1A           	ld a,(de)	;080a
3033  080B 9C           	sbc a,h		;080b	BA = (DE)-HL
3034  080C
3035  080C              l080ch:
3036  080C 38 04        	jr c,l0812h	;080c	Jump to FIND_LINE_NEXT if HL > line number
3037  080E
3038  080E 1B           	dec de		;080e	Decrement DE
3039  080F
3040  080F B0           	or b		;080f	Check if HL is equal to line number at (DE)
3041  0810
3042  0810 C9           	ret		;0810	Return
3043  0811
3044  0811              l0811h:
3045  0811 13           	inc de		;0811	Increment DE

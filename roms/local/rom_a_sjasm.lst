1418  02E2 1A           	ld a,(de)	;02e2
1419  02E3 13           	inc de		;02e3
1420  02E4 12           	ld (de),a	;02e4
1421  02E5
1422  02E5 1B           	dec de		;02e5	Decrement DE'
1423  02E6 D7           	rst 10h		;02e6	Compare with '_' cursor position in HL'
1424  02E7

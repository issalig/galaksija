1680  03B3              l03b3h:
1681  03B3 1B           	dec de		;03b3	Decrement DE
1682  03B4 18 12        	jr l03c8h	;03b4	Jump to PARSE_MATCH
1683  03B6
1684  03B6              ; A matching BASIC command has been found
1685  03B6
1686  03B6              ;; PARSE_DOT
1687  03B6              l03b6h:
1688  03B6 FE 2E        	cp 02eh		;03b6	Compare last character with ASCII '.'
1689  03B8 28 09        	jr z,l03c3h	;03b8	If equal then jump to PARSE_MATCH_PARTIAL
1690  03BA              			;	else continue checking with next command in
1691  03BA              			;	the command table.
1692  03BA
1693  03BA              ; Move (HL) to the next entry in the BASIC command table
1694  03BA
1695  03BA              ;; PARSE_NEXT
1696  03BA              l03bah:
1697  03BA 23           	inc hl		;03ba	Increment HL until MSB of (HL) is set
1698  03BB CB 7E        	bit 7,(hl)	;03bb
1699  03BD 28 FB        	jr z,l03bah	;03bd
1700  03BF
1701  03BF 23           	inc hl		;03bf	Increment HL
1702  03C0 D1           	pop de		;03c0	Restore DE
1703  03C1 18 D7        	jr l039ah	;03c1	Jump to PARSE_FIRST
1704  03C3
1705  03C3              ;; PARSE_MATCH_PARTIAL
1706  03C3              l03c3h:
1707  03C3 23           	inc hl		;03c3	Increment HL until MSB of (HL) is set
1708  03C4 CB 7E        	bit 7,(hl)	;03c4
1709  03C6 28 FB        	jr z,l03c3h	;03c6
1710  03C8
1711  03C8              ;; PARSE_MATCH
1712  03C8              l03c8h:
1713  03C8 7E           	ld a,(hl)	;03c8	HL = (HL) & 7fffh
1714  03C9 23           	inc hl		;03c9	number in (HL) is big endian!
1715  03CA 6E           	ld l,(hl)	;03ca
1716  03CB E6 7F        	and 07fh	;03cb
1717  03CD 67           	ld h,a		;03cd
1718  03CE
1719  03CE F1           	pop af		;03ce	Removed saved DE from stack
1720  03CF CB 74        	bit 6,h		;03cf	Test bit 6 of H
1721  03D1 CB B4        	res 6,h		;03d1	Reset bit 6 of H
1722  03D3
1723  03D3 E5           	push hl		;03d3	Push HL to stack
1724  03D4

1630  0398              ; 'BASIC FUNCTION PARSER'
1631  0398              ; =======================
1632  0398              ; Parse BASIC commands at DE.
1633  0398
1634  0398              ; Parameters:
1635  0398              ;	DE: String containing BASIC commands.
1636  0398              ;	L: Low byte of a pointer to the appropriate command table.
1637  0398
1638  0398              ;; PARSE
1639  0398              l0398h:
1640  0398 26 0F        	ld h,00fh	;0398
1641  039A
1642  039A              ;; PARSE_FIRST
1643  039A              l039ah:
1644  039A CD 05 01     	call l0105h	;039a	Skip leading space and get first character
1645  039D              			;	from string in DE (Call EAT_SPACE)
1646  039D
1647  039D D5           	push de		;039d	Store address of the first character on stack
1648  039E
1649  039E 13           	inc de		;039e	Increment DE and HL
1650  039F 23           	inc hl		;039f
1651  03A0
1652  03A0 BE           	cp (hl)		;03a0	Compare first character with first character
1653  03A1              			;	in table
1654  03A1
1655  03A1 28 06        	jr z,l03a9h	;03a1	Jump to PARSE_COMPARE if equal.
1656  03A3
1657  03A3 CB 7E        	bit 7,(hl)	;03a3	Test MSB of (HL)
1658  03A5 20 0C        	jr nz,l03b3h	;03a5	Jump to PARSE_END if set
1659  03A7
1660  03A7 18 11        	jr l03bah	;03a7	Jump to PARSE_NEXT if characters do not match
1661  03A9
1662  03A9              ; Compares string in DE (BASIC line) with string in HL (BASIC command table)
1663  03A9
1664  03A9              ;; PARSE_COMPARE
1665  03A9              l03a9h:
1666  03A9 1A           	ld a,(de)	;03a9	Get next character
1667  03AA
1668  03AA 13           	inc de		;03aa	Increment DE and HL
1669  03AB 23           	inc hl		;03ab
1670  03AC
1671  03AC BE           	cp (hl)		;03ac	Compare character
1672  03AD 28 FA        	jr z,l03a9h	;03ad	Loop if they match
1673  03AF
1674  03AF CB 7E        	bit 7,(hl)	;03af	Test MSB of (HL)
1675  03B1 28 03        	jr z,l03b6h	;03b1	Jump to PARSE_DOT if not set.
1676  03B3
1677  03B3              ; Complete table has been checked and no matching BASIC command has been found
1678  03B3

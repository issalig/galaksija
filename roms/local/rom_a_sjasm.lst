1601  038C              ; 'PARSE AN IMMEDIATE COMMAND'
1602  038C              ; ============================
1603  038C              ; Parses and executes a BASIC command entered on the command line.
1604  038C
1605  038C              ; Calls PARSE with BASIC_CMDLINE_TABLE
1606  038C
1607  038C              ;; IMMEDIATE
1608  038C              l038ch:
1609  038C 21 17 03     	ld hl,l0317h	;038c	Push RESET_BASIC_2 address on stack
1610  038F E5           	push hl		;038f
1611  0390
1612  0390 2E 0E        	ld l,(l0f0fh-1)&00ffh
1613  0392              			;0390					HL = 0f0eh
1614  0392 01           	db 1		;0392  					BC = xx
1615  0393
1616  0393              ; 'EVALUATE NUMERIC FUNCTIONS'
1617  0393              ; ============================

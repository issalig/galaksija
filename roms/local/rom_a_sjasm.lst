2866  079A
2867  079A CD 37 09     	call l0937h	;079a	Call PRINTSTR
2868  079D
2869  079D ED 5B 9F 2A  	ld de,(02a9fh)	;079d	Load BASIC_LINE into DE
2870  07A1
2871  07A1 7B           	ld a,e		;07a1
2872  07A2 B2           	or d		;07a2	Set Z flag if BASIC_LINE is zero.
2873  07A3
2874  07A3 21 17 03     	ld hl,l0317h	;07a3	Load RESET_BASIC_2 address into
2875  07A6 E3           	ex (sp),hl	;07a6	the address at the top of the stack
2876  07A7              			;	and store stack value into HL.
2877  07A7
2878  07A7              			;	Top of the stack stores the current parser

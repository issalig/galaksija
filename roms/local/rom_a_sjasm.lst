 811  0165              ; 'CONVERT ASCII HEX CHAR TO AN INTEGER'
 812  0165              ; ======================================
 813  0165              ; This function converts a single ASCII character to its hexadecimal numerical
 814  0165              ; value (for example 'B' returns 11) and increments DE.
 815  0165
 816  0165              ; Parameters:
 817  0165              ;	DE: Pointer to the character to be converted
 818  0165              ; Returns:
 819  0165              ;	A: Numerical value of character in (DE) or the character in (DE) on
 820  0165              ;	   error (character not between ASCII '0' and '9').
 821  0165              ;	DE: Incremented by 1 or unmodified on error.
 822  0165              ;	C flag: Set on error, reset otherwise
 823  0165              ; Destroys:
 824  0165              ;	Flags
 825  0165
 826  0165              ;; HEXCHAR_TO_INT
 827  0165              l0165h:
 828  0165 CD 72 01     	call l0172h	;0165	First try to convert an ASCII integer
 829  0168 D0           	ret nc		;0168	return if call to CHAR_TO_INT succeeded
 830  0169
 831  0169 FE 41        	cp 041h		;0169	Return with Cf set if character less than 'A'
 832  016B D8           	ret c		;016b
 833  016C
 834  016C C6 09        	add a,009h	;016c	Add 09h to ASCII code (lower 4 bits are now
 835  016E              			;	equal to the hex value)
 836  016E
 837  016E FE 50        	cp 050h		;016e	Compare with 'F' + 09h + 1
 838  0170
 839  0170 18 06        	jr l0178h	;0170	Jump forward (check for error, clear upper
 840  0172              			;	for bits and return)
 841  0172
 842  0172              ; 'CONVERT ASCII CHAR TO AN INTEGER'
 843  0172              ; ==================================
 844  0172              ; This function converts a single ASCII character to its decimal numerical
 845  0172              ; value and increments DE.
 846  0172
 847  0172              ; Parameters:
 848  0172              ;	DE: Pointer to the character to be converted
 849  0172              ; Returns:
 850  0172              ;	A: Numerical value of character in (DE) or the character in (DE) on
 851  0172              ;	   error (character not between ASCII '0' and '9').
 852  0172              ;	DE: Incremented by 1 or unmodified on error.
 853  0172              ;	C flag: Set on error, reset otherwise
 854  0172              ; Destroys:
 855  0172              ;	Flags
 856  0172
 857  0172              ;; CHAR_TO_INT
 858  0172              l0172h:
 859  0172 1A           	ld a,(de)	;0172	Load (DE) into A
 860  0173 FE 30        	cp 030h		;0173	Compare with 30h (ASCII '0')...
 861  0175 D8           	ret c		;0175	...and return if smaller.
 862  0176
 863  0176 FE 3A        	cp 03ah		;0176	Compare with 3ah (ASCII '9' + 1)...
 864  0178              l0178h:
 865  0178 3F           	ccf		;0178	   (complement carry flag)
 866  0179 D8           	ret c		;0179	...and return if larger or equal.
 867  017A
 868  017A 13           	inc de		;017a	Increment DE
 869  017B              l017bh:
 870  017B E6 0F        	and 00fh	;017b	A = A & 0fh (clear upper 4 bits)
 871  017D              			;	also resets carry flag
 872  017D
 873  017D C9           	ret		;017d	Return
 874  017E
 875  017E              l017eh:
 876  017E 77           	ld (hl),a			;017e	77 	w
 877  017F              l017fh:
 878  017F 23           	inc hl			;017f	23 	#
 879  0180 7D           	ld a,l			;0180	7d 	}
 880  0181 18 F8        	jr l017bh		;0181	18 f8

4790  0CA9 CB 12        	rl d		;0ca9	Rotate D left
4791  0CAB 30 06        	jr nc,l0cb3h	;0cab	Add DE' B' if top bit of D is set...
4792  0CAD
4793  0CAD D9           	exx		;0cad
4794  0CAE 19           	add hl,de	;0cae   HL' C' = HL' C' + DE' B'
4795  0CAF 79           	ld a,c		;0caf
4796  0CB0 88           	adc a,b		;0cb0
4797  0CB1 4F           	ld c,a		;0cb1
4798  0CB2 D9           	exx		;0cb2
4799  0CB3
4800  0CB3              l0cb3h:
4801  0CB3 10 EF        	djnz l0ca4h	;0cb3	Loop 8 times
4802  0CB5
4803  0CB5 23           	inc hl		;0cb5	Increment HL
4804  0CB6
4805  0CB6 0D           	dec c		;0cb6	Decrement C
4806  0CB7 20 E8        	jr nz,l0ca1h	;0cb7	Loop 3 times
4807  0CB9
4808  0CB9 EF           	rst 28h		;0cb9	Call CLEAR_HL
4809  0CBA
4810  0CBA D9           	exx		;0cba
4811  0CBB D1           	pop de		;0cbb	Restore RND_SEED address from stack into DE'
4812  0CBC
4813  0CBC 7D           	ld a,l		;0cbc	L' = L' + 65h
4814  0CBD C6 65        	add a,065h	;0cbd	(RND_SEED) = L'
4815  0CBF 12           	ld (de),a	;0cbf
4816  0CC0 13           	inc de		;0cc0	Increment DE'
4817  0CC1 6F           	ld l,a		;0cc1
4818  0CC2
4819  0CC2 7C           	ld a,h		;0cc2	H' = H' + b0h + Cf
4820  0CC3 CE B0        	adc a,0b0h	;0cc3	(RND_SEED+1) = H'
4821  0CC5 12           	ld (de),a	;0cc5
4822  0CC6 13           	inc de		;0cc6	Increment DE'
4823  0CC7 67           	ld h,a		;0cc7
4824  0CC8
4825  0CC8 79           	ld a,c		;0cc8	C' + 05h + Cf
4826  0CC9 CE 05        	adc a,005h	;0cc9	(RND_SEED+2) = C'
4827  0CCB 12           	ld (de),a	;0ccb
4828  0CCC 4F           	ld c,a		;0ccc
4829  0CCD
4830  0CCD CD 14 09     	call l0914h	;0ccd	Call CORRECT_EXP_ADD_IX_10
4831  0CD0 C3 6D 0B     	jp l0b6dh	;0cd0	Jump to STORE_ARITHM_RET
4832  0CD3
4833  0CD3              ; 'CONVERT STRING TO AN INTEGER'
4834  0CD3              ; ==============================
4835  0CD3              ; Converts string at DE into an integer. String must start with a numeral.
4836  0CD3
4837  0CD3              ; Parameters:
4838  0CD3              ;	DE: Pointer to the string to be converted.
4839  0CD3              ; Returns:
4840  0CD3              ;	HL: Converted integer or 0 on error.
4841  0CD3              ;	Zf: Set on error or clears on success.
4842  0CD3              ;	DE: First character after the converted number.
4843  0CD3
4844  0CD3              ;; STRING_TO_INT
4845  0CD3              l0cd3h:
4846  0CD3 EF           	rst 28h		;0cd3	Call CLEAR_HL
4847  0CD4 CD 05 01     	call l0105h	;0cd4	Call EAT_SPACE
4848  0CD7
4849  0CD7 CD 72 01     	call l0172h	;0cd7	Check if the next character is a number
4850  0CDA              			;	(call CHAR_TO_INT)
4851  0CDA
4852  0CDA 38 07        	jr c,l0ce3h	;0cda	If it's not, jump forward
4853  0CDC
4854  0CDC 1B           	dec de		;0cdc	Decrement DE (step back to character used for
4855  0CDD              			;	CHAR_TO_INT)
4856  0CDD
4857  0CDD              			;	Convert the string at DE to integer in HL.
4858  0CDD
4859  0CDD CD A2 01     	call l01a2h	;0cdd	Call STRING_TO_FP
4860  0CE0 CD 6D 0A     	call l0a6dh	;0ce0	Call FP_TO_INT
4861  0CE3              l0ce3h:
4862  0CE3 7C           	ld a,h		;0ce3	Check if HL contains 0 (either the number
4863  0CE4 B5           	or l		;0ce4	read is 0 or the conversion failed)
4864  0CE5
4865  0CE5 C9           	ret		;0ce5	Return
4866  0CE6
4867  0CE6              ; 'READ A KEY FROM KEYBOARD'
4868  0CE6              ; ==========================
4869  0CE6              ; Waits for a key press on the keyboard and returns the code of the pressed
4870  0CE6              ; key in A (for most keys this means the ASCII code of the character printed
4871  0CE6              ; on the key. Special keys return their own scan code).
4872  0CE6
4873  0CE6              ; A press to the "list" key causes a jump to the LIST function.
4874  0CE6
4875  0CE6              ; A press to the "break" key causes a jump to the BREAK function.
4876  0CE6
4877  0CE6              ; Returns:
4878  0CE6              ;	A: Code of the key pressed
4879  0CE6              ; Destroys:
4880  0CE6              ;	Flags
4881  0CE6
4882  0CE6              ; A key had been seen as released. Key code in A. Address in DE.
4883  0CE6
4884  0CE6              ; Clear the key's position in KEY_DIFF (HL), if this key has been recently
4885  0CE6              ; pressed.
4886  0CE6
4887  0CE6              ;; KEY_RELEASED
4888  0CE6              l0ce6h:
4889  0CE6 BC           	cp h		;0ce6	Compare A with H...
4890  0CE7 20 02        	jr nz,l0cebh	;0ce7	...and jump forward if not equal
4891  0CE9
4892  0CE9 26 00        	ld h,000h	;0ce9	...else reset H
4893  0CEB              l0cebh:
4894  0CEB BD           	cp l		;0ceb	Compare A with L...
4895  0CEC 20 02        	jr nz,l0cf0h	;0cec	...and jump to KEY_READ_NEXT if not equal
4896  0CEE
4897  0CEE 2E 00        	ld l,000h	;0cee	...else reset L
4898  0CF0
4899  0CF0              ; Scan the next key, or start from the beginning if on the last key.
4900  0CF0
4901  0CF0              ;; KEY_READ_NEXT
4902  0CF0              l0cf0h:
4903  0CF0
4904  0CF0 1D           	dec e		;0cf0	Decrement E, move to the next key
4905  0CF1 20 0B        	jr nz,l0cfeh	;0cf1	Jump to KEY_READ if more keys to read
4906  0CF3 18 06        	jr l0cfbh	;0cf3	Jump to KEY_RESTART if on the last key.
4907  0CF5
4908  0CF5              ; Entry point into the function
4909  0CF5
4910  0CF5              ;; KEY
4911  0CF5              l0cf5h:
4912  0CF5 D9           	exx		;0cf5	Save BC, DE and HL registers
4913  0CF6
4914  0CF6 2A A5 2A     	ld hl,(02aa5h)	;0cf6	Load KEY_DIFF into HL
4915  0CF9
4916  0CF9 0E 0E        	ld c,00eh	;0cf9	Load 0eh into C (speed of the "repeat" key)
4917  0CFB
4918  0CFB              ; Restart scanning from the beginning.
4919  0CFB
4920  0CFB              ;; KEY_RESTART
4921  0CFB              l0cfbh:
4922  0CFB 11 34 20     	ld de,02034h	;0cfb	Load 2034h into DE
4923  0CFE              			;	This is the address of the last key on the
4924  0CFE              			;	keyboard except for "shift".
4925  0CFE
4926  0CFE              ;; KEY_READ
4927  0CFE              l0cfeh:
4928  0CFE 1A           	ld a,(de)	;0cfe	Load (DE) into A
4929  0CFF 0F           	rrca		;0cff	Rotate A right through carry flag
4930  0D00 7B           	ld a,e		;0d00	Load E (code of the current key) into A
4931  0D01
4932  0D01 38 E3        	jr c,l0ce6h	;0d01	Jump to KEY_RELEASED if low bit of A is set.
4933  0D03
4934  0D03 FE 32        	cp 032h		;0d03	Compare A with 32h...
4935  0D05 20 08        	jr nz,l0d0fh	;0d05	...and jump to KEY_PRESSED, if not equal
4936  0D07
4937  0D07              ; "rept" key is pressed. This key is special because it causes the last
4938  0D07              ; keypress to be repeated.
4939  0D07
4940  0D07 0D           	dec c		;0d07	Decrement C...
4941  0D08 20 DC        	jr nz,l0ce6h	;0d08	...and jump to KEY_RELEASED if not zero
4942  0D0A
4943  0D0A 3A B4 2B     	ld a,(02bb4h)	;0d0a	Load LAST_KEY into A
4944  0D0D 18 45        	jr l0d54h	;0d0d	Jump to KEY_END
4945  0D0F
4946  0D0F              ; A key had been seen as pressed. Key code in A. Address in DE.
4947  0D0F
4948  0D0F              ;; KEY_PRESSED
4949  0D0F              l0d0fh:
4950  0D0F BC           	cp h		;0d0f	Compare A with H...
4951  0D10 28 DE        	jr z,l0cf0h	;0d10	...and jump to KEY_READ_NEXT if equal
4952  0D12
4953  0D12 BD           	cp l		;0d12	Compare A with L...
4954  0D13 28 DB        	jr z,l0cf0h	;0d13	...and jump to KEY_READ_NEXT if equal
4955  0D15
4956  0D15              ; Wait for 256 cycles for key release (to filter out switch bounces)
4957  0D15
4958  0D15 06 00        	ld b,000h	;0d15	Clear B
4959  0D17              l0d17h:
4960  0D17 D7           	rst 10h		;0d17	Call CMP_HL_DE (pause)
4961  0D18
4962  0D18 1A           	ld a,(de)	;0d18	Load (DE) into A
4963  0D19 0F           	rrca		;0d19	Rotate A right through carry flag...
4964  0D1A 38 CA        	jr c,l0ce6h	;0d1a	...and jump to KEY_RELEASED if carry set.
4965  0D1C
4966  0D1C 10 F9        	djnz l0d17h	;0d1c	Loop 256 times
4967  0D1E
4968  0D1E              ; Fill in an empty position in KEY_DIFF (HL)
4969  0D1E
4970  0D1E 7C           	ld a,h		;0d1e	Load H into A
4971  0D1F B7           	or a		;0d1f	Set Z flag...
4972  0D20 20 03        	jr nz,l0d25h	;0d20	...and jump forward if A not zero
4973  0D22
4974  0D22 63           	ld h,e		;0d22	Load E into H
4975  0D23 18 05        	jr l0d2ah	;0d23	Jump forward
4976  0D25
4977  0D25              l0d25h:
4978  0D25 7D           	ld a,l		;0d25	Load L into A
4979  0D26 B7           	or a		;0d26	Set Z flag...
4980  0D27 20 D5        	jr nz,l0cfeh	;0d27	...and jump to KEY_READ if A not zero
4981  0D29 6B           	ld l,e		;0d29	Load E into L
4982  0D2A
4983  0D2A              ; A valid key press has been detected. Check for special keys, add proper
4984  0D2A              ; ASCII offsets and look keys up in the shift table. DE holds the key's
4985  0D2A              ; memory address.
4986  0D2A
4987  0D2A              ;; KEY_COMPUTE
4988  0D2A              l0d2ah:
4989  0D2A 22 A5 2A     	ld (02aa5h),hl	;0d2a	Load HL into KEY_DIFF
4990  0D2D EF           	rst 28h		;0d2d	Call CLEAR_HL
4991  0D2E 7B           	ld a,e		;0d2e	Load E into A
4992  0D2F
4993  0D2F              ; Check for special keys, that directly invoke functions in the BASIC
4994  0D2F              ; interpreter.
4995  0D2F
4996  0D2F FE 34        	cp 034h		;0d2f	Compare A with 34h ("list" key) and...
4997  0D31 CA 61 04     	jp z,l0461h	;0d31	...jump to LIST_KEY if equal
4998  0D34
4999  0D34 FE 31        	cp 031h		;0d34	Compare A with 31h ("break" key) and...
5000  0D36 CA 05 03     	jp z,l0305h	;0d36	...jump to BREAK if equal
5001  0D39
5002  0D39 FE 1B        	cp 01bh		;0d39	Compare A with 1bh ("up" key).
5003  0D3B 21 35 20     	ld hl,02035h	;0d3b	Load 2035h into HL ("shift" key address)
5004  0D3E 38 19        	jr c,l0d59h	;0d3e	Jump to KEY_END_ALPHA if A less than 1bh
5005  0D40
5006  0D40 FE 1F        	cp 01fh		;0d40	Compare A with 1fh ("space" key address)
5007  0D42 38 10        	jr c,l0d54h	;0d42	Jump to KEY_END if A is less than 1fh
5008  0D44              			;	("up", "down", "left" or "right" keys)
5009  0D44
5010  0D44              ; Code for numerical and symbol keys, that are looked up in KEY_SHIFT_SYM_TABLE
5011  0D44
5012  0D44 D6 1F        	sub 01fh	;0d44	Subtract 1fh from A
5013  0D46 CB 1E        	rr (hl)		;0d46	Rotate (HL) right
5014  0D48              			;	Since HL contains the address of the "shift"
5015  0D48              			;	key, this moves that status of the "shift" key
5016  0D48              			;	into carry flag.
5017  0D48
5018  0D48 17           	rla		;0d48	Rotate A left.
5019  0D49              			;	A = A * 2 + 0 (if shift is pressed)
5020  0D49              			;	A = A * 2 + 1 (if shirt is released)
5021  0D49
5022  0D49 4F           	ld c,a		;0d49	Load A into C
5023  0D4A
5024  0D4A 21 70 0D     	ld hl,l0d70h	;0d4a	Load KEY_SHIFT_SYM_TABLE address into HL
5025  0D4D 09           	add hl,bc	;0d4d	Add BC to HL
5026  0D4E
5027  0D4E              ; This seeds the random generator with the value of the R register after
5028  0D4E              ; some key presses.
5029  0D4E
5030  0D4E ED 5F        	ld a,r		;0d4e	Load R into A
5031  0D50 32 A8 2A     	ld (02aa8h),a	;0d50	Load A into 2nd byte of RND_SEED
5032  0D53
5033  0D53 7E           	ld a,(hl)	;0d53	Load a character from the symbol table into A
5034  0D54
5035  0D54              ; The code of the pressed key is in A. Store in LAST_KEY and return.
5036  0D54
5037  0D54              ;; KEY_END
5038  0D54              l0d54h:
5039  0D54 32 B4 2B     	ld (02bb4h),a	;0d54	Load A into LAST_KEY
5040  0D57 D9           	exx		;0d57	Restore BC, DE and HL registers.
5041  0D58 C9           	ret		;0d58	Return
5042  0D59
5043  0D59              ; Pressed key is a letter. Add proper ASCII offset, check shift mapping in
5044  0D59              ; table and return.
5045  0D59
5046  0D59              ;; KEY_END_ALPHA
5047  0D59              l0d59h:
5048  0D59 C6 40        	add a,040h	;0d59	Add 40h to A (ASCII offset)
5049  0D5B CB 1E        	rr (hl)		;0d5b	Rotate (HL) right...
5050  0D5D              			;	Since HL contains the address of the "shift"
5051  0D5D              			;	key, this moves that status of the "shift" key
5052  0D5D              			;	into carry flag.
5053  0D5D 38 F5        	jr c,l0d54h	;0d5d	...and jump to KEY_END if shift key not pressed.
5054  0D5F
5055  0D5F 21 94 0D     	ld hl,l0d94h	;0d5f	Load KEY_SHIFT_YU_TABLE address into HL
5056  0D62 01 5B 04     	ld bc,l045bh	;0d62	Load 4 into B and 5bh into C
5057  0D65
5058  0D65              ; B holds the length of the KEY_SHIFT_YU_TABLE, C holds the first ASCII code
5059  0D65              ; of the Yugoslavian character set.
5060  0D65
5061  0D65              l0d65h:
5062  0D65 BE           	cp (hl)		;0d65	Compare (HL) with A...
5063  0D66 28 05        	jr z,l0d6dh	;0d66	Jump forward if equal
5064  0D68 23           	inc hl		;0d68	Increment HL
5065  0D69 0C           	inc c		;0d69	Increment C
5066  0D6A 10 F9        	djnz l0d65h	;0d6a	Loop 4 times
5067  0D6C
5068  0D6C              ; If loops ends here, a dummy load instruction is executed. Else value in C
5069  0D6C              ; (a different character) is stored into A
5070  0D6C
5071  0D6C 0E           	db 00eh		;0d6c	These two bytes also form the instruction
5072  0D6D              l0d6dh:
5073  0D6D 79           	ld a,c		;0d6d	"ld c,079h"
5074  0D6E
5075  0D6E 18 E4        	jr l0d54h	;0d6e	Jump to KEY_END
5076  0D70
5077  0D70              ; 'KEYBOARD TABLES'
5078  0D70              ; =================
5079  0D70
5080  0D70              ; This table contains characters, that are obtained by pressing keys with
5081  0D70              ; addresses from 1fh ("space") to 30h ("return").
5082  0D70
5083  0D70              ; The first character in table is obtained by pressing shift-key and the
5084  0D70              ; second is obtained by pressing the key alone.
5085  0D70
5086  0D70              ;; KEY_SHIFT_SYM_TABLE
5087  0D70              l0d70h:
5088  0D70 20 20        	db	' ',	' '	; 1fh
5089  0D72 5F 30        	db	'_',	'0'	; 20h
5090  0D74 21 31        	db	'!',	'1'	; 21h
5091  0D76 22 32        	db	'"',	'2'	; 22h
5092  0D78 23 33        	db	'#',	'3'	; 23h
5093  0D7A 24 34        	db	'$',	'4'	; 24h
5094  0D7C 25 35        	db	'%',	'5'	; 25h
5095  0D7E 26 36        	db	'&',	'6'	; 26h
5096  0D80 BF 37        	db	0bfh,	'7'	; 27h (bfh is block graphics character)
5097  0D82 28 38        	db	'(',	'8'	; 28h
5098  0D84 29 39        	db	')',	'9'	; 29h
5099  0D86 2B 3B        	db	'+',	';'	; 2ah
5100  0D88 2A 3A        	db	'*',	':'	; 2bh
5101  0D8A 3C 2C        	db	'<',	','	; 2ch
5102  0D8C 2D 3D        	db	'-',	'='	; 2dh
5103  0D8E 3E 2E        	db	'>',	'.'	; 2eh
5104  0D90 3F 2F        	db	'?',	'/'	; 2fh
5105  0D92 0D 0D        	db	00dh,	00dh	; 30h (CR)
5106  0D94
5107  0D94              ; This table contains characters, that are mapped to Yugoslavian characters
5108  0D94              ; when the shift-key is pressed.
5109  0D94
5110  0D94              ; It also serves as the KEY_SHIFT_SYM_TABLE entries for "break" and "repeat"
5111  0D94              ; keys, which have special functions and are never looked up here.
5112  0D94
5113  0D94              ;; KEY_SHIFT_YU_TABLE
5114  0D94              l0d94h:
5115  0D94 58           	db	'X' 		; C with caron		31h
5116  0D95 43           	db 	'C'		; C with acute
5117  0D96 5A           	db 	'Z'		; Z with caron		32h
5118  0D97 53           	db	'S'		; S with caron
5119  0D98
5120  0D98              ; KEY_SHIFT_SYM_TABLE entry for the "delete" key
5121  0D98
5122  0D98 0C 00        	db	0ch,	00h	; 33h (clear screen - shift delete, delete)
5123  0D9A
5124  0D9A              ; 'MEM'
5125  0D9A              ; =====
5126  0D9A              ; "MEM" BASIC function
5127  0D9A
5128  0D9A              ;; MEM
5129  0D9A              l0d9ah:

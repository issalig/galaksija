5131  0D9D
5132  0D9D ED 4B 99 2A  	ld bc,(02a99h)	;0d9d	Subtract array length from
5133  0DA1 ED 42        	sbc hl,bc	;0da1
5134  0DA3
5135  0DA3 18 1A        	jr l0dbfh	;0da3	Jump to INT_TO_FP and return
5136  0DA5
5137  0DA5              ; 'WORD'
5138  0DA5              ; ======
5139  0DA5              ; "WORD" BASIC function
5140  0DA5
5141  0DA5              ;; WORD
5142  0DA5              l0da5h:
5143  0DA5 4E           	ld c,(hl)	;0da5	Load word at (HL) into HL
5144  0DA6 23           	inc hl		;0da6
5145  0DA7 66           	ld h,(hl)	;0da7
5146  0DA8 69           	ld l,c		;0da8
5147  0DA9
5148  0DA9 18 14        	jr l0dbfh	;0da9	Jump to INT_TO_FP and return.
5149  0DAB
5150  0DAB              ; 'KEY'
5151  0DAB              ; =====
5152  0DAB              ; "KEY" BASIC function
5153  0DAB
5154  0DAB              ;; KEY_CMD
5155  0DAB              l0dabh:
5156  0DAB 7C           	ld a,h		;0dab	Check if HL = 0
5157  0DAC B5           	or l		;0dac
5158  0DAD 20 05        	jr nz,l0db4h	;0dad	If HL = 0 (no argument),
5159  0DAF              			;	read which key has been pressed and return
5160  0DAF
5161  0DAF CD F5 0C     	call l0cf5h	;0daf	Call KEY
5162  0DB2 18 06        	jr l0dbah	;0db2	Jump to KEY_CMD_END
5163  0DB4
5164  0DB4              l0db4h:
5165  0DB4 CB EC        	set 5,h		;0db4	HL = HL | 2000h
5166  0DB6
5167  0DB6 7E           	ld a,(hl)	;0db6	Load value from keyboard into A
5168  0DB7 2F           	cpl		;0db7	Complement A
5169  0DB8              l0db8h:
5170  0DB8 E6 01        	and 001h	;0db8	Filter out LSB.
5171  0DBA
5172  0DBA              ;; KEY_CMD_END
5173  0DBA              l0dbah:
5174  0DBA 6F           	ld l,a		;0dba	Move A into L.
5175  0DBB 3E           	db 03eh		;0dbb	Dummy "ld a,nn" (skip next instruction -
5176  0DBC              			;	clear H and jump to INT_TO_FP)
5177  0DBC
5178  0DBC              ; 'BYTE'
5179  0DBC              ; ======
5180  0DBC              ; "BYTE" BASIC function
5181  0DBC
5182  0DBC              ;; BYTE_FUNC
5183  0DBC              l0dbch:
5184  0DBC 6E           	ld l,(hl)	;0dbc	Load byte at (HL) into HL

 882  0183              ; 'FREE MEMORY REMAINING'
 883  0183              ; =======================
 884  0183              ; Calculate bytes available from end of BASIC program to top of RAM
 885  0183
 886  0183              ; Returns:
 887  0183              ;	HL: Free bytes available.
 888  0183
 889  0183              ;; FREE_MEM
 890  0183              l0183h:
 891  0183 D5           	push de		;0183	Save DE to stack
 892  0184
 893  0184 ED 5B 38 2C  	ld de,(02c38h)	;0184	Load BASIC_END into DE
 894  0188
 895  0188              ; 'SUBTRACT HL FROM RAM_TOP'
 896  0188              ; ==========================
 897  0188
 898  0188              ; Returns:
 899  0188              ;	HL: HL = RAM_TOP - HL
 900  0188
 901  0188              ;; SUB_RAMTOP_HL
 902  0188              l0188h:
 903  0188 2A 6A 2A     	ld hl,(02a6ah)	;0188	Load RAM_TOP into DE
 904  018B
 905  018B 7D           	ld a,l		;018b	HL = HL & 0fff0h
 906  018C E6 F0        	and 0f0h	;018c	(resets Cf)
 907  018E 6F           	ld l,a		;018e
 908  018F
 909  018F ED 52        	sbc hl,de	;018f	HL = HL - DE - 0
 910  0191
 911  0191 D1           	pop de		;0191	Restore DE
 912  0192 AF           	xor a		;0192	Clear A (resets carry)
 913  0193
 914  0193 C9           	ret		;0193	Return
 915  0194
 916  0194              ; 'READ PARAMETER (cont.)'
 917  0194              ; ========================
 918  0194
 919  0194              ;; READ_PAR_2
 920  0194              l0194h:
 921  0194 23           	inc hl		;0194	Increment HL
 922  0195 28 07        	jr z,l019eh	;0195	Jump forward if character in DE matches
 923  0197
 924  0197 C5           	push bc		;0197	Save BC on stack
 925  0198 4E           	ld c,(hl)	;0198	Load (HL) into BC
 926  0199 06 00        	ld b,000h	;0199
 927  019B 09           	add hl,bc	;019b	Add BC to HL
 928  019C C1           	pop bc		;019c	Restore BC from stack
 929  019D
 930  019D 1B           	dec de		;019d	Decrement DE
 931  019E
 932  019E              l019eh:
 933  019E 13           	inc de		;019e	Increment DE
 934  019F 23           	inc hl		;019f	Increment HL
 935  01A0 E3           	ex (sp),hl	;01a0	Store HL back to the top of the stack
 936  01A1 C9           	ret		;01a1	Return
 937  01A2
 938  01A2              ; 'CONVERT STRING TO FLOATING POINT NUMBER'
 939  01A2              ; =========================================
 940  01A2              ; Converts a string at DE to a floating point number and pushes it to the
 941  01A2              ; arithmetic stack.
 942  01A2
 943  01A2              ; Returns:
 944  01A2              ;	Zf: Set if no errors occured
 945  01A2
 946  01A2              ;; STRING_TO_FP
 947  01A2              l01a2h:
 948  01A2 CD 48 02     	call l0248h	;01a2	Clear HL' C' (call CLEAR_CX_HLX_B6)
 949  01A5
 950  01A5 06 00        	ld b,000h	;01a5	Clear B and C
 951  01A7 48           	ld c,b		;01a7
 952  01A8
 953  01A8 CD 05 01     	call l0105h	;01a8	Skip any leading whitespace (call EAT_SPACE)
 954  01AB
 955  01AB              l01abh:
 956  01AB CD B0 01     	call l01b0h	;01ab	Call STRING_TO_FP_FETCH_DECIMAL
 957  01AE 18 FB        	jr l01abh	;01ae	Loop
 958  01B0
 959  01B0              ;		L'	H'	C'	L	H
 960  01B0              ; ----------------------------------------------------------
 961  01B0              ;		24 bit mantissa		Exp	Sign
 962  01B0
 963  01B0              ; B register (holds status of the conversion)
 964  01B0
 965  01B0              ; bit	7	6	5	4	3	2	1	0
 966  01B0              ; ----------------------------------------------------------------------
 967  01B0              ; 	Mantissa overflow
 968  01B0
 969  01B0              ;		Mantissa started with a number
 970  01B0
 971  01B0              ;			Exponent started with a number

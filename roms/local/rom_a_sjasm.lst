2880  07A7              			;	function.
2881  07A7
2882  07A7 C8           	ret z		;07a7	Return into RESET_BASIC_2 if BASIC_LINE = 0
2883  07A8
2884  07A8 D7           	rst 10h		;07a8	Call CMP_HL_DE
2885  07A9
2886  07A9 D8           	ret c		;07a9	Return into RESET_BASIC_2 if
2887  07AA              			;	BASIC_LINE > current parser address
2888  07AA
2889  07AA              			;	(stack did not contain a valid parser address)
2890  07AA
2891  07AA 4E           	ld c,(hl)	;07aa	Save character at current parser addr. into C
2892  07AB C5           	push bc		;07ab	Store BC on stack
2893  07AC

2769  075E 38 08        	jr c,l0768h		;075e	38 08 	8
2770  0760 F5           	push af			;0760	f5
2771  0761 DF           	rst 18h			;0761	df
2772  0762 3D           	dec a			;0762	3d 	=
2773  0763 2B           	dec hl			;0763	2b 	+
2774  0764 F1           	pop af			;0764	f1
2775  0765 CD B2 05     	call l05b2h		;0765	cd b2 05
2776  0768              l0768h:
2777  0768 F7           	rst 30h			;0768	f7

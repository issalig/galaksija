1729  03DA
1730  03DA              ; 'START (cont.)'
1731  03DA              ; ===============
1732  03DA              ; This is the rest of the boot code (it is executed only once, at power on)
1733  03DA
1734  03DA              ;; START_2
1735  03DA              l03dah:
1736  03DA ED 56        	im 1		;03da	Set interrupt mode 1
1737  03DC FD 21 FD 00  	ld iy,l00fdh	;03dc	Load 00fdh into IY
1738  03E0              			;	(default video interrupt hook)
1739  03E0
1740  03E0 21 FF 27     	ld hl,027ffh	;03e0	Load latch address (27ffh) into HL
1741  03E3 75           	ld (hl),l	;03e3	Load ffh into the latch (disable A7 clamp,
1742  03E4              			;	empty character scanline)
1743  03E4
1744  03E4 45           	ld b,l		;03e4	Load ffh into B.
1745  03E5
1746  03E5              ; This routine clears the entire RAM, starting at 2800h, if A holds 00h.
1747  03E5
1748  03E5              l03e5h:
1749  03E5 23           	inc hl		;03e5	Increment HL
1750  03E6 70           	ld (hl),b	;03e6	Load B (ffh) into (HL)
1751  03E7 34           	inc (hl)	;03e7	Increment (HL)
1752  03E8              			;	(HL) should now hold 00h if the address in HL
1753  03E8              			;	is mapped to RAM.
1754  03E8
1755  03E8 20 03        	jr nz,l03edh	;03e8	If not zero, break from loop
1756  03EA              			;	(reached the end of RAM)
1757  03EA
1758  03EA B6           	or (hl)		;03ea	If (HL) | A ...
1759  03EB 28 F8        	jr z,l03e5h	;03eb	... is zero, loop
1760  03ED
1761  03ED              l03edh:
1762  03ED 22 6A 2A     	ld (02a6ah),hl	;03ed	Store the last address in RAM + 1 into RAM_TOP
1763  03F0
1764  03F0 31 AD 2B     	ld sp,02badh	;03f0	Set SP to 2badh
1765  03F3 21 0B C9     	ld hl,0c90bh	;03f3	Load c90bh into HL
1766  03F6 E5           	push hl		;03f6	Store c9h (ret) into 2bach (VIDEO_LINK)
1767  03F7              			;	Store 0bh into 2babh
1768  03F7
1769  03F7 3B           	dec sp		;03f7	Decrement SP (2baah)
1770  03F8 E5           	push hl		;03f8	Store c9h (ret) into 2ba9h (BASIC_LINK)
1771  03F9              			;	Store 0bh into 2ba8h (HORIZ_POS)
1772  03F9
1773  03F9              	if 1
1774  03F9 CD 00 10     	call 1000h  ;03f9   Call ROM B
1775  03FC              	else
1776  03FC ~            	ld a,00ch	;03f9	Load 0ch (ASCII FF) into A
1777  03FC ~            	rst 20h		;03fb	Call PUTCH_RST
1778  03FC ~            			;	This clears the screen and places cursor in
1779  03FC ~            			;	the top left corner
1780  03FC              	endif
1781  03FC
1782  03FC              ; Execution now continues to the NEW command. DE is (probably) set to 0000h
1783  03FC              ; after reset (points to the start of the ROM). Since there is no valid ASCII
1784  03FC              ; string there the code below behaves as if NEW command was called without an
1785  03FC              ; argument.
1786  03FC
1787  03FC              ; 'NEW'
1788  03FC              ; =====
1789  03FC              ; "NEW" BASIC command line command.
1790  03FC
1791  03FC              ;; NEW
1792  03FC              l03fch:
1793  03FC CD D3 0C     	call l0cd3h	;03fc	Read command argument (BASIC offset)
1794  03FF              			;	into HL (if any)
1795  03FF              			;	(call STRING_TO_INT)
1796  03FF
1797  03FF 11 3A 2C     	ld de,02c3ah	;03ff	Load 2c3ah (USER_MEM) into DE
1798  0402 19           	add hl,de	;0402	Add DE to HL
1799  0403
1800  0403 31 3A 2C     	ld sp,02c3ah	;0403	Load 2c3ah (USER_MEM) into SP
1801  0406 E5           	push hl		;0406	Store HL to 2c38 (BASIC_END)
1802  0407 E5           	push hl		;0407	Store HL to 2c36 (BASIC_START)
1803  0408              l0408h:
1804  0408 C3 67 00     	jp l0067h	;0408	Jump to RESET_BASIC
1805  040B
1806  040B              ; 'RUN'
1807  040B              ; =====
1808  040B              ; "RUN" BASIC command line command
1809  040B
1810  040B              ;; RUN
1811  040B              l040bh:
1812  040B CD D3 0C     	call l0cd3h	;040b	Read command argument
1813  040E              			;	(call STRING_TO_INT)
1814  040E
1815  040E ED 5B 36 2C  	ld de,(02c36h)	;040e	Load BASIC_START address into DE
1816  0412              l0412h:
1817  0412 18 0E        	jr l0422h	;0412	Jump to RUN_DO
1818  0414
1819  0414              ; 'CONTINUE'
1820  0414              ; ==========
1821  0414              ; Continue execution of a BASIC program.
1822  0414
1823  0414              ; A call to this function will try to execute the next command on the line
1824  0414              ; or will continue to the next line. If a valid command is found this function
1825  0414              ; never returns. On the other hand if neither ':' nor line end is encountered,
1826  0414              ; it returns.
1827  0414
1828  0414              ;; CONTINUE
1829  0414              l0414h:
1830  0414 32 B5 2B     	ld (02bb5h),a	;0414	Load A into FIXME
1831  0417
1832  0417 DF           	rst 18h		;0417	Call READ_PAR
1833  0418 3A           	db ':'		;0418
1834  0419 03           	db l041dh-$-1	;0419	Check for ':'. If not found jump to CONTINUE_CR
1835  041A
1836  041A              ;; ELSE
1837  041A              l041ah:
1838  041A F1           	pop af		;041a	Remove return address from stack.
1839  041B 18 10        	jr l042dh	;041b	Execute the rest of the line
1840  041D              			;	(jump to RUN_CONT_LINE)
1841  041D
1842  041D              ;; CONTINUE_CR
1843  041D              l041dh:
1844  041D DF           	rst 18h		;041d	Call READ_PAR
1845  041E 0D           	db 00dh		;041e
1846  041F 20           	db l0440h-$-1	;041f	Check for ASCII CR. If not found return.
1847  0420
1848  0420 F1           	pop af		;0420	Remove return address from stack and
1849  0421              			;	execute next BASIC line.
1850  0421
1851  0421              ; 'INTERPRET NEXT LINE OF BASIC'
1852  0421              ; =============================
1853  0421              ; Jump to this location finds the next BASIC line following DE and starts BASIC
1854  0421              ; interpreter at the BASIC.
1855  0421

 802  015E 26 2A        	ld h,02ah	;015e	HL = 2a00h + A * 4
 803  0160 17           	rla		;0160
 804  0161 17           	rla		;0161
 805  0162 6F           	ld l,a		;0162
 806  0163
 807  0163 AF           	xor a		;0163	Clear A and Cf
 808  0164
 809  0164 C9           	ret		;0164	Return

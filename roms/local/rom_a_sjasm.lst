5591  0ED9
5592  0ED9              ; Returns:
5593  0ED9              ;	L: low byte
5594  0ED9              ;	C: high byte
5595  0ED9              ;	B: B = B + sum of both loaded bytes
5596  0ED9              ;	flags: Result of the CMP_HL_DE function.
5597  0ED9
5598  0ED9              ;; LOAD_WORD
5599  0ED9              l0ed9h:
5600  0ED9 CD DD 0E     	call l0eddh	;0ed9	Call LOAD_BYTE
5601  0EDC 69           	ld l,c		;0edc	Save result into L
5602  0EDD
5603  0EDD              ; Continue with another LOAD_BYTE and return
5604  0EDD
5605  0EDD              ; 'LOAD BYTE'
5606  0EDD              ; ===========
5607  0EDD              ; This function loads one byte from the audio cassette.
5608  0EDD
5609  0EDD              ; Returns:
5610  0EDD              ;	C: byte loaded
5611  0EDD              ;	B: B = B + C
5612  0EDD
5613  0EDD              ;; LOAD_BYTE
5614  0EDD              l0eddh:
5615  0EDD D9           	exx		;0edd
5616  0EDE 06 01        	ld b,001h	;0ede	Load 1 into B'
5617  0EE0
5618  0EE0              l0ee0h:
5619  0EE0 3E A7        	ld a,0a7h	;0ee0	Load 167 into A
5620  0EE2
5621  0EE2              ; This block waits for an impulse on the cassette port. If B' = 1 (on first
5622  0EE2              ; iteration), it waits indefinitely. If B' = 0 it waits for A loop iterations.
5623  0EE2
5624  0EE2              ; 49 T * 167 = 8183 T = 2.7ms
5625  0EE2
5626  0EE2              ;; LOAD_WAIT_PULSE
5627  0EE2              l0ee2h:
5628  0EE2 80           	add a,b		;0ee2	4	Add B' to A
5629  0EE3 21 00 20     	ld hl,02000h	;0ee3	10	Load cassette port address into HL'
5630  0EE6 CB 46        	bit 0,(hl)	;0ee6	12	Test bit 0
5631  0EE8 28 07        	jr z,l0ef1h	;0ee8	12,7	If impulse was detected, break loop...
5632  0EEA 3D           	dec a		;0eea	4	...else decrement A and
5633  0EEB 20 F5        	jr nz,l0ee2h	;0eeb	12,7	   loop to LOAD_WAIT_PULSE if not zero
5634  0EED
5635  0EED D9           	exx		;0eed	4
5636  0EEE 79           	ld a,c		;0eee	4	Load C into A
5637  0EEF
5638  0EEF 18 A2        	jr l0e93h	;0eef		B = A + B, compare HL with DE
5639  0EF1              			;		and return from function
5640  0EF1
5641  0EF1              l0ef1h:
5642  0EF1
5643  0EF1              ; Pause for 4369 T = 1.42 ms
5644  0EF1
5645  0EF1 06 DA        	ld b,0dah	;0ef1	7	Load 218 into B'
5646  0EF3              l0ef3h:
5647  0EF3 3E A9        	ld a,0a9h	;0ef3	7	Load a9h into A
5648  0EF5 10 FC        	djnz l0ef3h	;0ef5	13,8	Loop
5649  0EF7
5650  0EF7 06 5A        	ld b,05ah	;0ef7	7	Load 90 into B'
5651  0EF9
5652  0EF9              ; This loop checks if the first pulse is followed by another one in specified
5653  0EF9              ; time interval. It has 90 iterations, each 35 T (11.4us) long. If input is
5654  0EF9              ; low in more than 4 iterations (so that A doesn't overflow), then bit 1 is
5655  0EF9              ; loaded into C. Else bit 0.
5656  0EF9
5657  0EF9              ; This gives a minimum pulse width of 140 T (45 us).
5658  0EF9
5659  0EF9              ;; LOAD_READ_PULSE
5660  0EF9              l0ef9h:
5661  0EF9 4E           	ld c,(hl)	;0ef9	7	Load C' from cassette port
5662  0EFA CB 19        	rr c		;0efa	8	Move bit 0 into carry flag...
5663  0EFC CE 00        	adc a,000h	;0efc	7	...and add it to A
5664  0EFE 10 F9        	djnz l0ef9h	;0efe	13,8	Loop to LOAD_READ_PULSE
5665  0F00
5666  0F00 07           	rlca		;0f00	Rotate A left (MSB into carry flag)
5667  0F01 D9           	exx		;0f01
5668  0F02 CB 19        	rr c		;0f02	Rotate C right (carry flag into MSB)
5669  0F04 D9           	exx		;0f04
5670  0F05
5671  0F05 18 D9        	jr l0ee0h	;0f05	Loop LOAD_WAIT_PULSE (B' = 0)
5672  0F07

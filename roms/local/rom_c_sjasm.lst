1309  EA10 ED 5B 04 2B          LD   DE,($2B04)     ;restore basic pointer
1310  EA14 FB                   EI                  ; enable interapt
1311  EA15 CD 52 EA             CALL $EA52          ;mute AY sound
1312  EA18 F7                   RST  $30            ;continue basic
1313  EA19 53 45 41 52          DEFB "SEARCHING"
1313  EA1D 43 48 49 4E
1313  EA21 47
1314  EA22 0D                   DEFB 13

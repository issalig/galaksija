1357  EA77              QLOAD_CMD:
1358  EA77 F1                   POP  AF             ;forget return address - QLOAD command
1359  EA78 ED 53 00 2B          LD   ($2B00),DE     ;store basic pointer (address names)
1360  EA7C CD 39 EA             CALL $EA39          ;initialize AY sound (A=0 on return)
1361  EA7F 3C                   INC  A              ;A=1 , $Zf=0
1362  EA80 F5                   PUSH AF             ;$XX01 onto stack (1=LOAD mode, $0=VERIFY mode)
1363  EA81 FB                   EI                  ;enable interapte (exit FAST mode to see messages)
1364  EA82 3E FF                LD   A,$FF
1365  EA84 F5                   PUSH AF             ;$XXFF onto stack (ie name not specified)
1366  EA85 DF                   RST  $18
1367  EA86 22                   DEFB $22            ; is the QLOAD command followed by a quotation mark ?
1368  EA87 1B                   DEFB $EAA3-$-1      ; if not, $jump to further checks
1369  EA88 EB                   EX   DE,HL          ;HL=address of the character after the first quotation mark (A=character of the first quotation mark)
1370  EA89 BE                   CP   (HL)           ; is the name given? (or just two quotes)
1371  EA8A EB                   EX   DE,HL          ;DE=basic pointer (points to second quote or first letter of name)
1372  EA8B 28 1E                JR   Z,$EAAB        ;if there is no name, $jump to check further parameters
1373  EA8D F1                   POP  AF             ;pop $XXFF off stack
1374  EA8E D5                   PUSH DE             ;start address of the name of the requested image on the stack
1375  EA8F AF                   XOR  A
1376  EA90 F5                   PUSH AF             ;$XX00 onto stack (means name is specified)
1377  EA91 06 15                LD   B,$15          ;find another quote (from here QLOAD and VERIFY are the same)
1378  EA93 13                   INC  DE
1379  EA94 10 00                DJNZ $EA96
1380  EA96 DF                   RST  $18
1381  EA97 22                   DEFB $22
1382  EA98 10                   DEFB $EAA9-$-1      ; if it is not a quote, $search further (to 15 places)
1383  EA99 1B                   DEC  DE             ;second quote found, $jump compensation (why?)
1384  EA9A 18 0F                JR   $EAAB          ;jump (why not JR $EAAC here without DEC DE ?)
1385  EA9C 1A                   LD   A,(DE)         ;A=character text (basic) (Why is this pinched here ???)
1386  EA9D FE 0D                CP   $0D            ;is it ENTER ?
1387  EA9F C8                   RET  Z              ;if so, $return with Zf=1
1388  EAA0 FE 3A                CP   $3A            ;is it a colon ?

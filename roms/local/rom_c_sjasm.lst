1324  EA3A D3 00                OUT  ($0),A         ;R0
1325  EA3C D3 01                OUT  ($1),A         ;channel A frequency (fine - 0)
1326  EA3E 3E 07                LD   A,$7
1327  EA40 D3 00                OUT  ($0),A         ;R7
1328  EA42 3E FE                LD   A,$FE
1329  EA44 D3 01                OUT  ($1),A         ;tone on channel A only
1330  EA46 3E 08                LD   A,$8
1331  EA48 D3 00                OUT  ($0),A         ;R8
1332  EA4A 3E 0F                LD   A,$0F

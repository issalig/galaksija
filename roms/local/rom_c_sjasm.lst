1147  E8D9              KILL_CMD:
1148  E8D9 18 2E                JR   $E909          ;KILL command
1149  E8DB              CLEAR_CMD:
1150  E8DB F1                   POP  AF             ;CLEAR command
1151  E8DC D5                   PUSH DE             ;save basic pointer
1152  E8DD DD E5                PUSH IX             ;save arithmetic stack pointer
1153  E8DF 06 1A                LD   B,$1A          ;26 variables from A to Z
1154  E8E1 DD 21 02 2A          LD   IX,$2A02

1276  E9CD 20 02                JR   NZ,$E9D1       ;if not, $record it
1277  E9CF 18 06                JR   $E9D7          ;if " , $jump
1278  E9D1 CD 68 0E             CALL $0E68          ;write name letter
1279  E9D4 13                   INC  DE             ;next letter
1280  E9D5 18 F3                JR   $E9CA          ;check this sign too
1281  E9D7 3E FF                LD   A,$FF          ;indicator byte ??
1282  E9D9 CD 68 0E             CALL $0E68          ;save indicator byte
1283  E9DC 78                   LD   A,B            ;A=CRC of bytes recorded so far
1284  E9DD 2F                   CPL                 ;complement CRC byte
1285  E9DE CD 68 0E             CALL $0E68          ;record CRC byte
1286  E9E1 06 0F                LD   B,$0F          ;pause ~4 seconds
1287  E9E3 21 00 80             LD   HL,$8000
1288  E9E6 2B                   DEC  HL
1289  E9E7 CB 7C                BIT  $7,H

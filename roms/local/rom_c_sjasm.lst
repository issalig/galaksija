1399  EAB3 ED 53 04 2B          LD   ($2B04),DE     ;save basic pointer (address of continuation of basic)
1400  EAB7 E5                   PUSH HL             ;RELOC parameter to stack
1401  EAB8 11 19 EA             LD   DE,$EA19       ;message address "SEARCHING"
1402  EABB CD 37 09             CALL $0937          ;print message + new line

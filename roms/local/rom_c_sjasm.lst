1391  EAA6 EF                   RST  $28            ;HL=0
1392  EAA7 28 0A                JR   Z,$EAB3        ;if any, $jump
1393  EAA9 18 E8                JR   $EA93          ; if there is no . or ENTER, $search further for quotation marks (?)
1394  EAAB 13                   INC  DE             ;return the pointer to the end of the name
1395  EAAC EF                   RST  $28            ;HL=0 (RELOC parameter in case it is not specified)

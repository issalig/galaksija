1975  EEBA 24                   INC  H
1976  EEBB 37                   SCF
1977  EEBC C9                   RET
1978  EEBD              HLDUMP_CMD:
1979  EEBD CD 60 10             CALL $1060
1980  EEC0              HDUMP_CMD:
1981  EEC0 F1                   POP  AF
1982  EEC1 CF                   RST  $8
1983  EEC2 E5                   PUSH HL
1984  EEC3 CD 05 00             CALL $0005
1985  EEC6 EB                   EX   DE, HL
1986  EEC7 E3                   EX   (SP), HL
1987  EEC8 7C                   LD   A,H
1988  EEC9 85                   ADD  A,L
1989  EECA E5                   PUSH HL
1990  EECB 06 08                LD   B,$8
1991  EECD 86                   ADD  A, (HL)
1992  EECE 23                   INC  HL
1993  EECF 10 FC                DJNZ $EECD
1994  EED1 E1                   POP  HL
1995  EED2 F5                   PUSH AF
1996  EED3 CD 4F 13             CALL $134F
1997  EED6 06 08                LD   B,$8
1998  EED8 3E 20                LD   A,$20
1999  EEDA E7                   RST  $20
2000  EEDB 7E                   LD   A,(HL)
2001  EEDC CD 5C 13             CALL $135C
2002  EEDF 23                   INC  HL
2003  EEE0 10 F6                DJNZ $EED8
2004  EEE2 3E 20                LD   A,$20
2005  EEE4 E7                   RST  $20
2006  EEE5 F1                   POP  AF
2007  EEE6 CD 5C 13             CALL $135C
2008  EEE9 CD FF 02             CALL $02FF
2009  EEEC 3E 0D                LD   A,$0D
2010  EEEE E7                   RST  $20
2011  EEEF D7                   RST  $10
2012  EEF0 38 D6                JR   C,$EEC8
2013  EEF2 D1                   POP  DE
2014  EEF3 F7                   RST  $30
2015  EEF4              HLOAD_CMD:
2016  EEF4 F1                   POP  AF             ;HLOAD command
2017  EEF5 CF                   RST  $8             ;get parameter (address of input start)
2018  EEF6 CD B5 EC             CALL $ECB5          ;turn off ROM-C (back to (one)line editor !!!)
2019  EEF9 E5                   PUSH HL             ;(BAG. in case of gross error ROM-C remains off !!!)
2020  EEFA E5                   PUSH HL             ;start address on stack 2x
2021  EEFB E1                   POP  HL             ;HL=address from stack
2022  EEFC CD 4F 13             CALL $134F          ; print HEX address
2023  EEFF E5                   PUSH HL             ;address back on stack
2024  EF00 3E 20                LD   A,$20          ;A=ASCII blank
2025  EF02 11 B6 2B             LD   DE,$2BB6       ;DE=address of input buffer
2026  EF05 12                   LD   (DE),A         ; the first character of the input buffer is blank
2027  EF06 13                   INC  DE             ;DE=cursor address in input buffer
2028  EF07 E7                   RST  $20            ; on the screen after the address, $the same blank
2029  EF08 D9                   EXX
2030  EF09 36 5F                LD   (HL),$5F       ;print cursor on screen (block) after blank
2031  EF0B D9                   EXX
2032  EF0C CD 69 EC             CALL $EC69          ;wait for key press (new KEY(0))
2033  EF0F FE 01                CP   $1             ;is BRK pressed?
2034  EF11 28 6C                JR   Z,$EF7F        ;end of entry, $jump to power on ROM-C
2035  EF13 FE 02                CP   $2             ;is STOP/LIST pressed?\
2036  EF15 28 F5                JR   Z,$EF0C        ;wait for next key /(unnecessary)
2037  EF17 FE 1D                CP   $1D            ;is the left arrow pressed (delete)?
2038  EF19 28 13                JR   Z,$EF2E        ;if so, $jump to delete processing
2039  EF1B FE 0D                CP   $0D            ;has ENTER been pressed?
2040  EF1D 28 19                JR   Z,$EF38        ;if so, $jump to processing input
2041  EF1F FE 20                CP   $20            ;is any other control key pressed?
2042  EF21 38 E9                JR   C,$EF0C        ;if so, $wait for the next key
2043  EF23 08                   EX   AF,AF'         ;save character code in A'
2044  EF24 7B                   LD   A,E
2045  EF25 FE D1                CP   $D1            ;is the cursor at the end of the line?
2046  EF27 28 E3                JR   Z,$EF0C        ;if it is, $there is no printout, $wait for the key
2047  EF29 08                   EX   AF,AF'         ;A=printable character
2048  EF2A 12                   LD   (DE),A         ;write a character into the input buffer
2049  EF2B 13                   INC  DE             ;DE=next location of input buffer
2050  EF2C 18 D9                JR   $EF07          ;jump to print character on screen and wait for key
2051  EF2E 7B                   LD   A,E            ;delete processing
2052  EF2F FE B7                CP   $B7            ; is the cursor in the buffer at the 2nd position (address+blank is not deleted)
2053  EF31 28 D9                JR   Z,$EF0C        ;if so, $no deletion, $wait for another key
2054  EF33 1B                   DEC  DE             ;if not, $cursor in buffer one character back
2055  EF34 3E 1D                LD   A,$1D          ;A=erasure control code (left arrow - line editor !!)
2056  EF36 18 CF                JR   $EF07          ;jump to print character on screen and wait for key
2057  EF38 12                   LD   (DE),A         ; enter ENTER at the end of the buffer - processing the input
2058  EF39 E7                   RST  $20            ;print ENTER to screen (new line)
2059  EF3A 11 B6 2B             LD   DE,$2BB6       ;DE=start of input buffer (entry)
2060  EF3D CD 05 01             CALL $0105          ;skip blanks (A=first character in buffer)
2061  EF40 FE 0D                CP   $0D            ;is the sign ENTER?
2062  EF42 28 0A                JR   Z,$EF4E        ;if yes, $jump to end of line processing
2063  EF44 CD EE 18             CALL $18EE          ;read HEX number in HL (if not HEX number, $HOW? and ROM-C remains off)
2064  EF47 7D                   LD   A,L            ;A=number
2065  EF48 E1                   POP  HL             ;HL=address for number
2066  EF49 77                   LD   (HL),A         ; entry of number to address
2067  EF4A 23                   INC  HL             ;next address
2068  EF4B E5                   PUSH HL             ;keep recording address still
2069  EF4C 18 EF                JR   $EF3D          ;process next HEX number (8 + CRC)
2070  EF4E E1                   POP  HL             ;forget the last entry address - end of line processing
2071  EF4F E1                   POP  HL
2072  EF50 E5                   PUSH HL             ;HL=address of the first entry in the line
2073  EF51 06 08                LD   B,$8           ;B=number of entered HEX digits in the line (if there are less, $BAG?)
2074  EF53 7C                   LD   A,H            ;A=CRC basis (higher byte of starting address)
2075  EF54 85                   ADD  A,L            ;CRC+lower byte of address
2076  EF55 86                   ADD  A,(HL)         ;CRC+written byte
2077  EF56 23                   INC  HL             ;address of next byte
2078  EF57 10 FC                DJNZ $EF55          ;add all eight bytes
2079  EF59 BE                   CP   (HL)           ;is the CRC equal to the ninth written byte (again BAG !!!)
2080  EF5A 28 1F                JR   Z,$EF7B        ;if equal, $jump to next line entry
2081  EF5C E1                   POP  HL             ;set stack as...
2082  EF5D E5                   PUSH HL             ;...as at the beginning of the line
2083  EF5E E5                   PUSH HL             ;(will be repeated !!)
2084  EF5F 11 75 EF             LD   DE,$EF75       ;DE=address of error message "ERROR"
2085  EF62 CD 37 09             CALL $0937          ;print error message
2086  EF65 CD 39 EA             CALL $EA39          ;initialize AY sound
2087  EF68 3E AA                LD   A,$AA          ;A=frequency ~560Hz fine
2088  EF6A D3 01                OUT  ($1),A         ;write to register R0 for channel A
2089  EF6C 06 00                LD   B,$0
2090  EF6E 10 FE                DJNZ $EF6E          ;short pause (from .1s to .21s)
2091  EF70 CD 52 EA             CALL $EA52          ;mute sound
2092  EF73 18 86                JR   $EEFB          ;expect the same line again
2093  EF75 45 52 52 4F          DEFB "ERROR"
2093  EF79 52
2094  EF7A 0D                   DEFB 13
2095  EF7B F1                   POP  AF             ;forget line start address
2096  EF7C C3 F9 EE             JP   $EEF9          ;expect next line
2097  EF7F F3                   DI                  ;disable interrupts - REFLASH ROM C
2098  EF80 CD 00 E0             CALL $E000          ;initialize ROM-C (and set 32 ​​system variables)
2099  EF83 2A 6A 2A             LD   HL,($2A6A)     ;HL=new RAMTOP
2100  EF86 11 20 00             LD   DE,$0020       ;DE=number of system variables above RAMTOP
2101  EF89 19                   ADD  HL,DE          ;HL=old RAMTOP (with old system variables)
2102  EF8A 22 6A 2A             LD   ($2A6A),HL     ;set system variable RAMTOP
2103  EF8D 3E 0C                LD   A,$0C
2104  EF8F E7                   RST  $20            ;clear the screen
2105  EF90 C3 66 00             JP   $0066          ;jump to HARD-BREAK ("farm")
2106  EF93              UP_CMD:
2107  EF93 F1                   POP  AF             ;COMMAND UP
2108  EF94 CF                   RST  $8             ;read the parameter (how many bytes to raise the basic up)
2109  EF95 D5                   PUSH DE             ;save basic pointer
2110  EF96 E5                   PUSH HL             ;save parameter
2111  EF97 CB 7C                BIT  $7,H           ; is the parameter greater than 32767 ?
2112  EF99 20 2A                JR   NZ,$EFC5       ;if bigger HOW? (BUG. with ROM-D it will be stuck or RESET!!!)
2113  EF9B ED 5B 38 2C          LD   DE,($2C38)     ;DE=end of basic +1
2114  EF9F D5                   PUSH DE
2115  EFA0 19                   ADD  HL,DE          ;HL=new end of basic (end + parameter)
2116  EFA1 ED 5B 6A 2A          LD   DE,($2A6A)     ;DE=RAMTOP
2117  EFA5 D7                   RST  $10            ;is there room to move the base
2118  EFA6 D2 53 01             JP   NC,$0153       ;if none, $SORRY error message
2119  EFA9 E3                   EX   (SP), HL       ; new end of basic to stack
2120  EFAA E5                   PUSH HL             ;HL=old end of basic, $and onto stack
2121  EFAB ED 5B 36 2C          LD   DE,($2C36)     ;DE=start of basic
2122  EFAF CD EF EF             CALL $EFEF          ;is there a basic at all?
2123  EFB2 ED B8                LDDR                ;if any, $move the base
2124  EFB4 D1                   POP  DE             ;DE=saved parameter from stack
2125  EFB5 2A 38 2C             LD   HL,($2C38)     ;HL=BASIC_END (end of BASIC system variable)
2126  EFB8 19                   ADD  HL,DE          ;HL=new end of basic
2127  EFB9 22 38 2C             LD   ($2C38),HL     ;update system variable
2128  EFBC 2A 36 2C             LD   HL,($2C36)     ;HL=BASIC_START (basic start system variable)
2129  EFBF 19                   ADD  HL,DE          ;HL=new beginning of BASIC
2130  EFC0 22 36 2C             LD   ($2C36),HL     ;update system variable
2131  EFC3 D1                   POP  DE             ;DE=saved basic pointer
2132  EFC4 F7                   RST  $30            ;continue basic (after changing the address ??? but it works!)
2133  EFC5 C3 5A 06             JP   $065A          ;print message "HOW?"
2134  EFC8              DOWN_CMD:
2135  EFC8 F1                   POP  AF             ;COMMAND DOWN
2136  EFC9 CF                   RST  $8             ;read the parameter (how many bytes to lower the basic down)
2137  EFCA D5                   PUSH DE             ;save basic pointer
2138  EFCB CB 7C                BIT  $7,H           ;is the parameter greater than 32767?
2139  EFCD 20 F6                JR   NZ,$EFC5       ;if greater, $HOW? (BUG. with ROM-D it will be stuck or RESET!!!)
2140  EFCF EB                   EX   DE,HL          ;DE=parameter
2141  EFD0 EF                   RST  $28            ;HL=0
2142  EFD1 AF                   XOR  A              ;Cf=0
2143  EFD2 ED 52                SBC  HL,DE          ;HL= negative parameter
2144  EFD4 E5                   PUSH HL             ;negative parameter on stack
2145  EFD5 ED 5B 36 2C          LD   DE,($2C36)     ;DE=BASIC_START (start of basic)
2146  EFD9 D5                   PUSH DE             ;start of basic on stack
2147  EFDA 19                   ADD  HL,DE          ;HL=new start of basic (practical. start of basic - shift)
2148  EFDB 11 3A 2C             LD   DE,$2C3A       ;DE=start of BASIC RAM
2149  EFDE D7                   RST  $10            ;is the new start of basic still in RAM?
2150  EFDF DA 53 01             JP   C,$0153        ;if not, $error message SORRY
2151  EFE2 D1                   POP  DE             ;DE=old beginning of BASIC
2152  EFE3 E5                   PUSH HL             ;new start of BASIC on stack
2153  EFE4 D5                   PUSH DE             ;old start of BASIC on stack
2154  EFE5 2A 38 2C             LD   HL,($2C38)     ;HL=old end of basic
2155  EFE8 CD EF EF             CALL $EFEF          ;is there a basic at all?
2156  EFEB ED B0                LDIR                ;if there is, $put it down
2157  EFED 18 C5                JR   $EFB4          ;update system variables BASIC_START and BASIC_END
2158  EFEF D7                   RST  $10            ;are the beginning of the basic and the end of the basic the same? (SUBROUTINE !)
2159  EFF0 CA 8F 07             JP   Z,$078F        ;if they are (nothing to move), $report WHAT?
2160  EFF3 AF                   XOR  A              ;Cf=0
2161  EFF4 ED 52                SBC  HL,DE          ;HL=base length
2162  EFF6 44                   LD   B,H
2163  EFF7 4D                   LD   C,L
2164  EFF8 03                   INC  BC             ;BC=length of base +1
2165  EFF9 F1                   POP  AF             ;AF=return address
2166  EFFA E1                   POP  HL             ;HL=old end of basic
2167  EFFB D1                   POP  DE             ;DE=new end of basic
2168  EFFC F5                   PUSH AF             ;return address on stack
2169  EFFD C9                   RET                 ;return
2170  EFFE 47 2B                DEFB "G+"           ;(free space in ROM. smartly filled !)
2171  F000
# file closed: .//rom_c.asm

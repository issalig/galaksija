1924  EE65 0F                   RRCA
1925  EE66 D8                   RET  C
1926  EE67 3A 31 20             LD   A,($2031)
1927  EE6A 0F                   RRCA
1928  EE6B 38 F5                JR   C,$EE62
1929  EE6D ED 7B 32 2C          LD   SP,($2C32)
1930  EE71 C3 05 03             JP   $0305
1931  EE74 26 00                LD   H,$0
1932  EE76 CD AD EE             CALL $EEAD
1933  EE79 D0                   RET  NC
1934  EE7A 59                   LD   E,C
1935  EE7B 79                   LD   A,C
1936  EE7C A7                   AND  A
1937  EE7D 28 07                JR   Z,$EE86
1938  EE7F 0D                   DEC  C
1939  EE80 CD AD EE             CALL $EEAD
1940  EE83 38 F6                JR   C,$EE7B
1941  EE85 0C                   INC  C
1942  EE86 69                   LD   L,C
1943  EE87 4B                   LD   C,E

1316  EA26 0F                   RRCA                ;C=state of input port (bit 0)
1317  EA27 D0                   RET  NC             ;if Cf=0, $pulse detected, $return
1318  EA28 18 F9                JR   $EA23          ;if there is no impulse, $wait for it further
1319  EA2A 46 4F 55 4E          DEFB "FOUND "
1319  EA2E 44 20
1320  EA30 00                   DEFB 0
1321  EA31 4C 4F 41 44          DEFB "LOADING"
1321  EA35 49 4E 47
1322  EA38 0D                   DEFB 13

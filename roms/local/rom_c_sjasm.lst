1271  E9C0 2A 02 2B             LD   HL,($2B02)
1272  E9C3 CD 63 0E             CALL $0E63          ;record LINE number (autostart line)
1273  E9C6 ED 5B 00 2B          LD   DE,($2B00)     ;DE=beginning of name (first letter after the first ")
1274  E9CA 1A                   LD   A, (DE)

1263  E9AD 10 FA                DJNZ $E9A9          ;...all 100
1264  E9AF 3E A5                LD   A,$A5          ;header ID (and base for CRC in B register)
1265  E9B1 CD 68 0E             CALL $0E68          ;record header ID byte
1266  E9B4 3E FF                LD   A,$FF          ;indicator byte ??
1267  E9B6 CD 68 0E             CALL $0E68          ;record indicator
1268  E9B9 CD 63 0E             CALL $0E63          ;record HL
1269  E9BC EB                   EX   DE,HL

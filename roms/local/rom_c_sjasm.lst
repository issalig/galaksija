1253  E99C 22 02 2B             LD   ($2B02),HL     ;remember it
1254  E99F DF                   RST  $18            ;any more parameters?
1255  E9A0 2C                   DEFB ","            ;(is there a comma?)
1256  E9A1 02                   DEFB $E9A4-$-1      ;if not, $just basic
1257  E9A2 18 BF                JR   $E963          ;if yes, $take other parameters (start, $end, $[reloc])
1258  E9A4 18 E0                JR   $E986          ;set header for "basic only"
1259  E9A6 F3                   DI                  ;deny interapte - QSAVE 300bps header
1260  E9A7 06 64                LD   B,$64          ;counter leader bytes
